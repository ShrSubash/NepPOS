@page "/businesses"
@inject HeadOfficeAdmin HeadOffice
@inject NavigationManager Nav

<PageTitle>Businesses · NepPOS Portal</PageTitle>

<header class="page-head">
    <div>
        <h1>Businesses</h1>
        <p class="muted">Your customers: each café, grocery or shop that runs NepPOS.</p>
    </div>
    <a class="btn btn-primary" href="businesses/new">New business</a>
</header>

<form class="toolbar" @onsubmit="SearchAsync">
    <input type="search" placeholder="Search by name" @bind="_search" aria-label="Search businesses" />
    <button type="submit" class="btn">Search</button>
</form>

<ProblemMessage Text="@_problem" />

@if (_rows is { } rows)
{
    @if (rows.Count == 0)
    {
        <div class="empty">
            @if (string.IsNullOrWhiteSpace(_search))
            {
                <p>No businesses yet.</p>
                <a class="btn btn-primary" href="businesses/new">Add your first customer</a>
            }
            else
            {
                <p>No business matches “@_search”.</p>
            }
        </div>
    }
    else
    {
        <div class="card flush">
            <table class="table">
                <thead>
                    <tr><th>Business</th><th>Licence</th><th class="num">Stores</th><th class="num">Registers</th><th>Online</th><th>Last heard from</th></tr>
                </thead>
                <tbody>
                    @foreach (var b in rows)
                    {
                        <tr class="clickable" @onclick="@(() => Nav.NavigateTo($"businesses/{b.Id}"))">
                            <td><a href="businesses/@b.Id">@b.Name</a><div class="sub">Since @b.CreatedUtc.ToString("d MMM yyyy")</div></td>
                            <td>
                                @if (b.Licence is { } lic)
                                {
                                    <LicencePill Status="lic.Status" Level="lic.Level" Title="@lic.Headline" />
                                    <div class="sub">@LicencePlans.NameOf(lic.Plan) · until @lic.ValidUntilUtc.ToLocalTime().ToString("d MMM yyyy")</div>
                                }
                                else
                                {
                                    <span class="sub">Trial starts on first use</span>
                                }
                            </td>
                            <td class="num">@b.Stores</td>
                            <td class="num">@b.Registers</td>
                            <td>
                                @if (b.Registers == 0) { <span class="pill pill-off">No registers</span> }
                                else if (b.OnlineRegisters == b.Registers) { <span class="pill pill-ok">All @b.Registers</span> }
                                else { <span class="pill pill-warn">@b.OnlineRegisters of @b.Registers</span> }
                            </td>
                            <td title="@Format.Exact(b.LastSeenUtc)">@Format.Ago(b.LastSeenUtc)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<BusinessRow>? _rows;
    private string? _search;
    private string? _problem;

    protected override Task OnInitializedAsync() => SearchAsync();

    private async Task SearchAsync()
    {
        var result = await HeadOffice.BusinessesAsync(_search);
        (_rows, _problem) = (result.Value, result.Problem);
    }
}
