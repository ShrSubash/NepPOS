@page "/businesses/{Id:guid}"
@inject HeadOfficeAdmin HeadOffice

<PageTitle>@(_business?.Name ?? "Business") · NepPOS Portal</PageTitle>

<a class="back" href="businesses">← Businesses</a>

<ProblemMessage Text="@_problem" />

@if (_business is { } b)
{
    <header class="page-head">
        <div>
            @if (_renaming)
            {
                <form class="inline-form" @onsubmit="RenameAsync">
                    <input @bind="_newName" aria-label="Business name" maxlength="200" autofocus />
                    <button type="submit" class="btn btn-primary btn-small">Save</button>
                    <button type="button" class="btn btn-small" @onclick="() => _renaming = false">Cancel</button>
                </form>
            }
            else
            {
                <h1>@b.Name <button class="link-button small" @onclick="StartRename">Rename</button></h1>
            }
            <p class="muted">Customer since @b.CreatedUtc.ToString("d MMMM yyyy") · @Registers.Count() @(Registers.Count() == 1 ? "register" : "registers"), @Registers.Count(r => r.Online) online</p>
        </div>
        <button class="btn" @onclick="() => _addingStore = !_addingStore">Add store</button>
    </header>

    @if (_licence is { } lic)
    {
        <section class="card licence-card">
            <div class="card-head">
                <div>
                    <h2>Licence <LicencePill Status="lic.Status" Level="lic.State.Level" Title="@lic.State.Headline" /></h2>
                    <div class="sub">@LicencePlans.NameOf(lic.Plan) plan · @(lic.Status == LicenceStatus.Trial ? "trial" : "paid") until @Day(lic.ValidUntilUtc) · changed @Format.Ago(lic.UpdatedUtc)</div>
                </div>
                @if (_isOwner && !_editingLicence)
                {
                    <div class="licence-actions">
                        <button class="btn btn-small" @onclick="() => RenewAsync(1)" disabled="@_busy">Renew 1 month</button>
                        <button class="btn btn-small" @onclick="() => RenewAsync(12)" disabled="@_busy">Renew 1 year</button>
                        @if (lic.Status == LicenceStatus.Suspended)
                        {
                            <button class="btn btn-small" @onclick="ResumeAsync" disabled="@_busy">Resume</button>
                        }
                        else if (lic.Status != LicenceStatus.Cancelled)
                        {
                            <button class="btn btn-small btn-danger-outline" @onclick="StartSuspend">Suspend…</button>
                        }
                        <button class="btn btn-small" @onclick="() => StartEdit(null)">Change…</button>
                    </div>
                }
            </div>

            @if (lic.State.Level != LicenceLevel.Ok)
            {
                <p class="licence-note licence-@lic.State.Level.ToString().ToLowerInvariant()"><strong>@lic.State.Headline.</strong> @lic.State.Detail</p>
            }

            @if (lic.RegistersUsed > lic.MaxRegisters || lic.StoresUsed > lic.MaxStores)
            {
                <p class="licence-note licence-warning">
                    <strong>More in use than the plan allows.</strong>
                    @OverLimit(lic) Nothing stops, but no more can be added. Revoke what's no longer used below, or raise the limit.
                </p>
            }

            <dl class="licence-facts">
                <div><dt>Stores</dt><dd class="@(lic.StoresUsed > lic.MaxStores ? "over" : lic.StoresUsed == lic.MaxStores ? "full" : "")">@lic.StoresUsed of @lic.MaxStores</dd></div>
                <div><dt>Registers</dt><dd class="@(lic.RegistersUsed > lic.MaxRegisters ? "over" : lic.RegistersUsed == lic.MaxRegisters ? "full" : "")">@lic.RegistersUsed of @lic.MaxRegisters</dd></div>
                <div><dt>Includes</dt><dd>@(lic.Features.Count == 0 ? "Register only" : string.Join(", ", lic.Features.Select(LicenceFeatures.Label)))</dd></div>
                @if (!string.IsNullOrEmpty(lic.Message))
                {
                    <div class="wide"><dt>Message on their registers</dt><dd>@lic.Message</dd></div>
                }
            </dl>

            @if (_editingLicence)
            {
                <form class="form licence-form" @onsubmit="SaveLicenceAsync">
                    <div class="row4">
                        <div>
                            <label for="lp">Plan</label>
                            <select id="lp" value="@_edit.Plan" @onchange="e => ChoosePlan(e.Value?.ToString())">
                                @foreach (var plan in LicencePlans.All)
                                {
                                    <option value="@plan.Code">@plan.Name (@plan.MaxStores @(plan.MaxStores == 1 ? "store" : "stores"), @plan.MaxRegisters @(plan.MaxRegisters == 1 ? "register" : "registers"))</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label for="ls">Status</label>
                            <select id="ls" @bind="_edit.Status">
                                @foreach (var status in Enum.GetValues<LicenceStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label for="lu">Paid until</label>
                            <input id="lu" type="date" @bind="_edit.ValidUntil" />
                        </div>
                        <div class="pair">
                            <div><label for="lst">Stores</label><input id="lst" type="number" min="1" max="100" @bind="_edit.MaxStores" /></div>
                            <div><label for="lr">Registers</label><input id="lr" type="number" min="1" max="500" @bind="_edit.MaxRegisters" /></div>
                        </div>
                    </div>
                    <div class="feature-checks">
                        @foreach (var feature in LicenceFeatures.All)
                        {
                            <label class="check"><input type="checkbox" checked="@_edit.Features.Contains(feature)" @onchange="e => ToggleFeature(feature, e.Value is true)" /> @LicenceFeatures.Label(feature)</label>
                        }
                    </div>
                    <label for="lm">Message on their registers @(_edit.Status is LicenceStatus.Suspended or LicenceStatus.Cancelled ? "(required)" : "(optional)")</label>
                    <input id="lm" @bind="_edit.Message" maxlength="300" placeholder="e.g. Payment overdue since 1 Nov. Call NepPOS on 02 9000 0000." />
                    <label for="ln">Note for the activity log</label>
                    <input id="ln" @bind="_edit.Note" maxlength="200" placeholder="e.g. Paid by bank transfer, invoice 1042" />
                    <div class="actions">
                        <button type="submit" class="btn btn-primary" disabled="@_busy">Save licence</button>
                        <button type="button" class="btn" @onclick="() => _editingLicence = false">Cancel</button>
                    </div>
                    <p class="sub">Registers pick up the change within a minute of their next contact with Head Office.</p>
                </form>
            }
        </section>
    }

    @if (_addingStore)
    {
        <section class="card">
            <h2>New store</h2>
            <EditForm Model="_store" OnValidSubmit="AddStoreAsync" class="form">
                <DataAnnotationsValidator />
                <div class="row3">
                    <div>
                        <label for="sc">Store code</label>
                        <InputText id="sc" @bind-Value="_store.StoreCode" placeholder="STORE-002" />
                        <ValidationMessage For="() => _store.StoreCode" />
                    </div>
                    <div>
                        <label for="sn">Name</label>
                        <InputText id="sn" @bind-Value="_store.Name" placeholder="e.g. Harris Park" />
                        <ValidationMessage For="() => _store.Name" />
                    </div>
                    <div>
                        <label for="tz">Time zone</label>
                        <TimeZonePicker Id="tz" @bind-Value="_store.TimeZoneId" />
                    </div>
                </div>
                <div class="actions">
                    <button type="submit" class="btn btn-primary">Add store</button>
                    <button type="button" class="btn" @onclick="() => _addingStore = false">Cancel</button>
                </div>
            </EditForm>
        </section>
    }

    @foreach (var store in b.Stores)
    {
        <section class="card">
            <div class="card-head">
                <div>
                    <h2>@store.Name <span class="tag">@store.StoreCode</span></h2>
                    <div class="sub">@store.TimeZoneId</div>
                </div>
                <button class="btn btn-small" @onclick="() => IssueCodeAsync(store)">New activation code</button>
            </div>

            @if (_codes.TryGetValue(store.Id, out var issued))
            {
                <ShownOnce Label="Activation code" Value="@issued.Code"
                           Note="@($"Enter it on the new register (Manage → Head Office). Works once, expires {issued.ExpiresUtc:d MMM yyyy}.")" />
            }

            @if (store.Registers.Count == 0)
            {
                <p class="muted">No registers yet. Issue an activation code and enter it on the shop's PC.</p>
            }
            else
            {
                <table class="table">
                    <thead><tr><th>Register</th><th>Key</th><th>Activated</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in store.Registers)
                        {
                            <tr class="@(r.IsRevoked ? "dim" : "")">
                                <td>@r.RegisterCode<div class="sub">@(r.DeviceName ?? "Unnamed device")</div></td>
                                <td><code>@r.ApiKeyPrefix…</code></td>
                                <td title="@Format.Exact(r.ActivatedUtc)">@Format.Ago(r.ActivatedUtc)</td>
                                <td><RegisterStatus Register="r" /><div class="sub">@Format.When(r.LastSeenUtc)</div></td>
                                <td class="right">
                                    @if (!r.IsRevoked)
                                    {
                                        <ConfirmButton Text="Revoke" ConfirmText="Revoke: it stops syncing" OnConfirm="() => RevokeRegisterAsync(r)" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }

    <section class="card">
        <div class="card-head">
            <div>
                <h2>Website keys</h2>
                <div class="sub">For an online shop that sends orders and reads the catalogue.</div>
            </div>
        </div>

        @if (_newKey is { } key)
        {
            <ShownOnce Label="@($"Website key: {key.Name}")" Value="@key.ApiKey"
                       Note="Put it in the website's settings (NepPOS:ApiKey). Copy it now. It won't be shown again." />
        }

        @if (b.WebsiteKeys.Count > 0)
        {
            <table class="table">
                <thead><tr><th>Name</th><th>Key</th><th>Created</th><th>Last used</th><th></th></tr></thead>
                <tbody>
                    @foreach (var k in b.WebsiteKeys)
                    {
                        <tr class="@(k.IsRevoked ? "dim" : "")">
                            <td>@k.Name</td>
                            <td><code>@k.ApiKeyPrefix…</code></td>
                            <td>@Format.Ago(k.CreatedUtc)</td>
                            <td title="@Format.Exact(k.LastUsedUtc)">@Format.Ago(k.LastUsedUtc)</td>
                            <td class="right">
                                @if (k.IsRevoked)
                                {
                                    <span class="pill pill-off">Revoked</span>
                                }
                                else
                                {
                                    <ConfirmButton Text="Revoke" ConfirmText="Revoke: the website stops working" OnConfirm="() => RevokeKeyAsync(k)" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <form class="inline-form" @onsubmit="CreateKeyAsync">
            <input @bind="_keyName" placeholder="Name, e.g. hamrogrocery.com.au" aria-label="Website key name" maxlength="100" />
            <button type="submit" class="btn btn-small">Create website key</button>
        </form>
    </section>

    <section class="card">
        <div class="card-head"><h2>Activity</h2></div>
        <ActivityList Entries="_activity" ShowBusiness="false" />
    </section>
}
else if (_problem is null)
{
    <p class="muted">Loading…</p>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private BusinessDetail? _business;
    private List<AuditEntryRow> _activity = [];
    private readonly Dictionary<Guid, IssuedActivationCode> _codes = [];
    private IssuedWebsiteKey? _newKey;
    private string? _problem;

    private bool _renaming;
    private string _newName = "";
    private bool _addingStore;
    private NewStoreInput _store = new();
    private string _keyName = "";

    // ---- Licence ----
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private LicenceDetail? _licence;
    private bool _isOwner;
    private bool _editingLicence;
    private bool _busy;
    private LicenceInput _edit = new();

    private static string OverLimit(LicenceDetail l)
    {
        var parts = new List<string>();
        if (l.RegistersUsed > l.MaxRegisters) parts.Add($"{l.RegistersUsed} registers are active and the plan allows {l.MaxRegisters}.");
        if (l.StoresUsed > l.MaxStores) parts.Add($"{l.StoresUsed} stores exist and the plan allows {l.MaxStores}.");
        return string.Join(" ", parts);
    }

    private static string Day(DateTime utc) => utc.ToLocalTime().ToString("d MMM yyyy");

    private IEnumerable<RegisterRow> Registers => _business?.Stores.SelectMany(s => s.Registers).Where(r => !r.IsRevoked) ?? [];

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var business = await HeadOffice.BusinessAsync(Id);
        (_business, _problem) = (business.Value, business.Problem);
        if (AuthState is not null)
            _isOwner = (await AuthState).User.IsInRole(StaffRoles.Owner);
        if (business.Ok)
        {
            var licence = await HeadOffice.LicenceAsync(Id);
            _licence = licence.Value;
            _problem ??= licence.Problem;
            var activity = await HeadOffice.AuditAsync(Id, 20);
            _activity = activity.Value ?? [];
        }
    }

    /// <summary>Runs a change, then reloads so the page shows what Head Office now has.</summary>
    private async Task<bool> ChangeAsync(Func<Task<string?>> change)
    {
        _problem = await change();
        var ok = _problem is null;
        var problem = _problem;
        await LoadAsync();
        _problem ??= problem;
        return ok;
    }

    private void StartRename() => (_renaming, _newName) = (true, _business?.Name ?? "");

    private async Task RenameAsync()
    {
        if (await ChangeAsync(async () => (await HeadOffice.RenameBusinessAsync(Id, _newName.Trim())).Problem))
            _renaming = false;
    }

    private async Task AddStoreAsync()
    {
        if (await ChangeAsync(async () => (await HeadOffice.CreateStoreAsync(Id, _store.StoreCode.Trim().ToUpperInvariant(), _store.Name.Trim(), _store.TimeZoneId)).Problem))
            (_addingStore, _store) = (false, new());
    }

    private async Task IssueCodeAsync(StoreDetail store)
    {
        var result = await HeadOffice.IssueActivationCodeAsync(store.Id);
        if (result.Ok)
            _codes[store.Id] = result.Value!;
        await ChangeAsync(() => Task.FromResult(result.Problem));
    }

    private Task RevokeRegisterAsync(RegisterRow register) =>
        ChangeAsync(async () => (await HeadOffice.RevokeRegisterAsync(register.Id)).Problem);

    private Task RevokeKeyAsync(WebsiteKeyRow key) =>
        ChangeAsync(async () => (await HeadOffice.RevokeWebsiteKeyAsync(key.Id)).Problem);

    private async Task CreateKeyAsync()
    {
        var name = string.IsNullOrWhiteSpace(_keyName) ? "Website" : _keyName.Trim();
        var result = await HeadOffice.CreateWebsiteKeyAsync(Id, name);
        if (result.Ok)
            (_newKey, _keyName) = (result.Value, "");
        await ChangeAsync(() => Task.FromResult(result.Problem));
    }

    private void StartEdit(LicenceStatus? status)
    {
        if (_licence is not { } l) return;
        _edit = new LicenceInput
        {
            Plan = l.Plan,
            Status = status ?? l.Status,
            ValidUntil = l.ValidUntilUtc.ToLocalTime().Date,
            MaxStores = l.MaxStores,
            MaxRegisters = l.MaxRegisters,
            Features = l.Features.ToHashSet(),
            Message = l.Message ?? ""
        };
        _editingLicence = true;
    }

    private void StartSuspend() => StartEdit(LicenceStatus.Suspended);

    /// <summary>Picking a plan fills in its limits and features; they can still be changed for this business.</summary>
    private void ChoosePlan(string? code)
    {
        if (LicencePlans.Find(code) is not { } plan) return;
        _edit.Plan = plan.Code;
        _edit.MaxStores = plan.MaxStores;
        _edit.MaxRegisters = plan.MaxRegisters;
        _edit.Features = plan.Features.ToHashSet();
    }

    private void ToggleFeature(string feature, bool on)
    {
        if (on) _edit.Features.Add(feature); else _edit.Features.Remove(feature);
    }

    private Task SaveLicenceAsync() => SendLicenceAsync(_edit.ToRequest(), closeForm: true);

    /// <summary>Paid for N more months: from the current end date, or from today if it has already passed. Active again.</summary>
    private Task RenewAsync(int months)
    {
        if (_licence is not { } l) return Task.CompletedTask;
        var from = l.ValidUntilUtc > DateTime.UtcNow ? l.ValidUntilUtc : DateTime.UtcNow;
        var request = new UpdateLicenceRequest(l.Plan, LicenceStatus.Active, from.AddMonths(months), l.MaxStores, l.MaxRegisters, l.Features,
            l.Status == LicenceStatus.Suspended ? null : l.Message, $"Renewed {months} {(months == 1 ? "month" : "months")}");
        return SendLicenceAsync(request, closeForm: false);
    }

    private Task ResumeAsync()
    {
        if (_licence is not { } l) return Task.CompletedTask;
        // Back in force; if the paid period has also run out, the page then shows it as ended until renewed.
        return SendLicenceAsync(new UpdateLicenceRequest(l.Plan, LicenceStatus.Active, l.ValidUntilUtc, l.MaxStores, l.MaxRegisters, l.Features, null, "Resumed"), closeForm: false);
    }

    private async Task SendLicenceAsync(UpdateLicenceRequest request, bool closeForm)
    {
        _busy = true;
        try
        {
            if (await ChangeAsync(async () => (await HeadOffice.UpdateLicenceAsync(Id, request)).Problem) && closeForm)
                _editingLicence = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class LicenceInput
    {
        public string Plan { get; set; } = LicencePlans.TrialPlan.Code;
        public LicenceStatus Status { get; set; }
        public DateTime ValidUntil { get; set; } = DateTime.UtcNow.Date;
        public int MaxStores { get; set; } = 1;
        public int MaxRegisters { get; set; } = 1;
        public HashSet<string> Features { get; set; } = new();
        public string Message { get; set; } = "";
        public string Note { get; set; } = "";

        // Paid until the end of the chosen day.
        public UpdateLicenceRequest ToRequest() =>
            new(Plan, Status, DateTime.SpecifyKind(ValidUntil.Date.AddDays(1).AddSeconds(-1), DateTimeKind.Local).ToUniversalTime(), MaxStores, MaxRegisters,
                Features.ToList(), Message, Note);
    }

    private sealed class NewStoreInput
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter a store code.")]
        [System.ComponentModel.DataAnnotations.RegularExpression("^[A-Za-z0-9-]{2,32}$", ErrorMessage = "Letters, numbers and dashes, e.g. STORE-002.")]
        public string StoreCode { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter the store's name.")]
        public string Name { get; set; } = "";

        public string TimeZoneId { get; set; } = TimeZonePicker.Zones[0].Id;
    }
}
