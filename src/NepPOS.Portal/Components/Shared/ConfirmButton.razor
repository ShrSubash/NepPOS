@* A button that asks "are you sure" in place (no browser pop-up): first click arms it, second click does it. *@
@if (_armed)
{
    <span class="confirm">
        <button type="button" class="btn btn-small btn-danger" disabled="@_busy" @onclick="ConfirmAsync">@ConfirmText</button>
        <button type="button" class="btn btn-small" @onclick="() => _armed = false">Cancel</button>
    </span>
}
else
{
    <button type="button" class="btn btn-small btn-ghost-danger" @onclick="() => _armed = true">@Text</button>
}

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter, EditorRequired] public string ConfirmText { get; set; } = "";
    [Parameter, EditorRequired] public EventCallback OnConfirm { get; set; }

    private bool _armed;
    private bool _busy;

    private async Task ConfirmAsync()
    {
        _busy = true;
        try
        {
            await OnConfirm.InvokeAsync();
        }
        finally
        {
            (_busy, _armed) = (false, false);
        }
    }
}
