<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The messages NepPOS registers, Head Office and the HamroGrocery website exchange.
    No dependencies on purpose: every system can reference it. Published as a NuGet package
    in integration build step 4. Change it only by adding (see docs/integration/events.md).
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
