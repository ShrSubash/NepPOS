@using NepPOS.Application.Sales
@using NepPOS.Domain.Entities
@inject IGiftCardService GiftCards

@*
    Sell a gift card (a new code, or the code on a physical card), top one up, or check a balance.
    The card is loaded only when the sale is paid; until then it's just a line on the order.
*@
<div class="rd-overlay">
    <div class="rd-shell gc-shell">
        <div class="rd-head">
            <h2>Gift card</h2>
            <button class="rd-close" @onclick="() => OnClose.InvokeAsync()">Close</button>
        </div>

        @if (_message is not null)
        {
            <div class="rd-msg @(_isError ? "error" : "")">@_message</div>
        }

        <label class="gc-label">Card number</label>
        <form class="rd-find" @onsubmit="CheckAsync">
            <input @ref="_codeInput" @bind="_code" placeholder="Scan the card, or tap New card" autocomplete="off" />
            <button type="submit" class="rd-btn" disabled="@_busy">Check balance</button>
            <button type="button" class="rd-btn" disabled="@_busy" @onclick="NewCodeAsync">New card</button>
        </form>

        @if (_balance is { } b)
        {
            <div class="rd-info"><strong>@b.KindName @b.Code</strong><span>@b.Balance.ToString("C") left</span>@if (!b.IsActive) { <span class="gc-bad">Cancelled</span> }</div>
        }

        <label class="gc-label">Amount to load</label>
        <div class="gc-amounts">
            @foreach (var a in Amounts)
            {
                <button class="rd-chip @(_amount == a ? "on" : "")" @onclick="() => _amount = a">@a.ToString("C0")</button>
            }
            <input class="gc-other" type="number" min="1" max="1000" step="1" @bind="_amount" @bind:event="oninput" />
        </div>

        <div class="rd-foot">
            <span class="rd-muted">Gift cards are GST-free when sold; GST is paid when they're spent.</span>
            <button class="rd-btn primary" disabled="@(!CanAdd)" @onclick="AddAsync">
                Add @(_balance is null ? "gift card" : "top-up") @(_amount > 0 ? _amount.ToString("C") : "")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<(string Code, decimal Amount)> OnAdd { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly decimal[] Amounts = { 20m, 50m, 100m, 200m };
    private ElementReference _codeInput;
    private string _code = "";
    private decimal _amount = 50m;
    private GiftCardBalance? _balance;
    private string? _message;
    private bool _isError;
    private bool _busy;

    private bool CanAdd => !_busy && _amount is > 0 and <= 1000 && IGiftCardService.LooksLikeCode(_code)
                           && _code.Trim().StartsWith("GC-", StringComparison.OrdinalIgnoreCase)
                           && (_balance is null || _balance.IsActive);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await _codeInput.FocusAsync(); } catch (InvalidOperationException) { }
        }
    }

    private async Task CheckAsync()
    {
        _busy = true;
        try
        {
            _code = _code.Trim().ToUpperInvariant();
            if (!IGiftCardService.LooksLikeCode(_code))
            {
                Show("Card numbers look like GC-1234567890 (gift card) or SC-1234567890 (store credit).", true);
                _balance = null;
                return;
            }
            _balance = await GiftCards.GetAsync(_code);
            Show(_balance is null ? $"{_code} is new: it will be loaded when this sale is paid." : null, false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task NewCodeAsync()
    {
        _busy = true;
        try
        {
            _code = await GiftCards.NewCodeAsync(GiftCardKind.GiftCard);
            _balance = null;
            Show($"New card {_code}. Its number prints on the receipt as a barcode.", false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddAsync()
    {
        if (!CanAdd) return;
        await CheckAsync();
        if (_balance is { IsActive: false }) return;
        await OnAdd.InvokeAsync((_code.Trim().ToUpperInvariant(), decimal.Round(_amount, 2)));
    }

    private void Show(string? text, bool error) => (_message, _isError) = (text, error);
}
