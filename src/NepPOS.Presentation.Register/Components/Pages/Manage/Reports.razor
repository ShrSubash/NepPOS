    private static string TenderName(TenderType tender) => tender == TenderType.Eftpos ? "EFTPOS" : tender.ToString();

    private static string HourText(int hour) =>
        $"{DateTime.Today.AddHours(hour):h tt} – {DateTime.Today.AddHours(hour + 1):h tt}".ToLowerInvariant();

    private static string Money(decimal amount) => amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-AU"));

    private static string Pct(decimal part, decimal whole) =>
        whole == 0 ? "0%" : (part / whole * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private string Share(decimal amount) => Pct(amount, Report?.GrossSales ?? 0);

    // Bar length relative to the biggest row (or the total), as a CSS width.
    private static string Width(decimal value, decimal max) =>
        max <= 0 ? "0%" : $"{Math.Clamp(value / max * 100, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%";

    // ---- compared with the period before ----

    private EndOfDayReport? Previous;
    private string? CompareText;

    /// <summary>
    /// Loads the same days of the period before (this week Mon–Wed against last week Mon–Wed), so a part
    /// week or month is never compared with a whole one. Only for reports made of closed days.
    /// </summary>
    private async Task LoadComparisonAsync()
    {
        Previous = null;
        CompareText = null;
        if (Report?.Title is null || Report.RangeFrom is not { } from || Report.Days.Count == 0)
            return;

        var to = Report.Days.Max(d => d.TradingDay);
        var days = to.DayNumber - from.DayNumber + 1;
        var (prevFrom, prevTo, label) = Selected switch
        {
            ReportView.ThisWeek => (from.AddDays(-7), to.AddDays(-7), "the same days last week"),
            ReportView.LastWeek => (from.AddDays(-7), to.AddDays(-7), "the week before"),
            ReportView.ThisMonth => (from.AddMonths(-1), to.AddMonths(-1), "the same days last month"),
            ReportView.LastMonth => (from.AddMonths(-1), to.AddMonths(-1), "the month before"),
            ReportView.ThisYear => (from.AddYears(-1), to.AddYears(-1), "the same days last year"),
            ReportView.LastYear => (from.AddYears(-1), to.AddYears(-1), "the year before"),
            _ => (from.AddDays(-days), from.AddDays(-1), $"the {days} day{(days == 1 ? "" : "s")} before")
        };

        try
        {
            var previous = await ReportService.GetPeriodAsync(prevFrom, prevTo, Report.Title);
            if (previous.Days.Count == 0)
            {
                CompareText = $"No closed days in {label} ({prevFrom:d MMM} – {prevTo:d MMM yyyy}) to compare with.";
                return;
            }

            Previous = previous;
            CompareText = $"Arrows compare with {label}: {prevFrom:ddd d MMM} – {prevTo:ddd d MMM yyyy}.";
        }
        catch (Exception)
        {
            // The report itself is fine; it just shows without arrows.
            CompareText = null;
        }
    }

    private decimal? PreviousAverage => Previous is null ? null : Previous.SaleCount == 0 ? 0 : Previous.GrossSales / Previous.SaleCount;

    /// <summary>▲ 12% / ▼ 8% against the period before; nothing when there's nothing to compare.</summary>
    private RenderFragment Delta(decimal now, decimal? before, bool money = true) => __builder =>
    {
        if (Previous is null || before is null) return;

        string css, text;
        if (before == 0)
            (css, text) = now > 0 ? ("up", "new") : ("flat", "same");
        else
        {
            var change = (now - before.Value) / before.Value * 100;
            (css, text) = Math.Abs(change) < 0.5m
                ? ("flat", "same")
                : (change > 0 ? "up" : "down", $"{(change > 0 ? "▲" : "▼")} {Math.Abs(change).ToString(change is > -10 and < 10 ? "0.0" : "0", System.Globalization.CultureInfo.InvariantCulture)}%");
        }

        <span class="k-delta @css" title="@($"Before: {(money ? Money(before.Value) : before.Value.ToString("0"))}")">@text</span>
    };

    // ---- by day ----

    private bool TabShown(ReportTab tab) => tab != ReportTab.Days || Report?.Days.Count > 0;

    private DayTotal? BestDay => Report?.Days.Where(d => d.SaleCount > 0).OrderByDescending(d => d.GrossSales).FirstOrDefault();

    private DayTotal? QuietestDay => Report?.Days.Where(d => d.SaleCount > 0).OrderBy(d => d.GrossSales).FirstOrDefault();

    /// <summary>A year has too many days for one chart: months instead.</summary>
    private bool ByMonth => Report?.Days.Count > 45;

    private sealed record Column(string Label, string Sub, string Title, decimal Amount, int Count, bool Weekend);

    private List<Column> Columns => Report is null ? new()
        : ByMonth
            ? Report.Days
                .GroupBy(d => new DateOnly(d.TradingDay.Year, d.TradingDay.Month, 1))
                .OrderBy(g => g.Key)
                .Select(g => new Column(g.Key.ToString("MMM"), g.Key.ToString("yy"), g.Key.ToString("MMMM yyyy"), g.Sum(d => d.GrossSales), g.Sum(d => d.SaleCount), false))
                .ToList()
            : Report.Days
                .OrderBy(d => d.TradingDay)
                .Select(d => new Column(d.TradingDay.Day.ToString(), d.TradingDay.ToString("ddd")[..2], d.TradingDay.ToString("dddd d MMMM"), d.GrossSales, d.SaleCount,
                    d.TradingDay.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday))
                .ToList();

    private sealed record WeekdayAverage(string Day, int Days, decimal Average);

    private List<WeekdayAverage> WeekdayAverages => (Report?.Days ?? Array.Empty<DayTotal>())
        .GroupBy(d => d.TradingDay.DayOfWeek)
        .OrderBy(g => ((int)g.Key + 6) % 7)   // Monday first
        .Select(g => new WeekdayAverage(g.Key.ToString(), g.Count(), g.Average(d => d.GrossSales)))
        .ToList();

    /// <summary>$1.2k, $940: short enough to sit above a narrow column.</summary>
    private static string Short(decimal amount) => amount >= 1000
        ? "$" + (amount / 1000).ToString(amount >= 10000 ? "0" : "0.0", System.Globalization.CultureInfo.InvariantCulture) + "k"
        : "$" + amount.ToString("0", System.Globalization.CultureInfo.InvariantCulture);

    // ---- slow sellers ----

    private List<Product>? ActiveProducts;

    private async Task LoadProductsAsync()
    {
        try
        {
            ActiveProducts = (await ProductCatalog.GetAllAsync()).Where(p => p.IsActive).ToList();
        }
        catch (Exception)
        {
            ActiveProducts = null;
        }
    }

    // The same key the register puts on each sale line: PLU, else barcode, else the internal id.
    private static string SkuOf(Product p) =>
        !string.IsNullOrWhiteSpace(p.Plu) ? p.Plu
        : !string.IsNullOrWhiteSpace(p.Barcode) ? p.Barcode
        : $"P{p.Id}";

    /// <summary>Active products with no sale line in this report (a pack size sold counts for its product).</summary>
    private List<Product> Unsold
    {
        get
        {
            if (Report is null || ActiveProducts is null) return new();
            var skus = Report.Products.Select(p => p.Sku).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var names = Report.Products.Select(p => p.Name).ToList();
            return ActiveProducts
                .Where(p => !skus.Contains(SkuOf(p))
                            && !names.Any(n => n.Equals(p.Name, StringComparison.OrdinalIgnoreCase)
                                               || n.StartsWith(p.Name + " (", StringComparison.OrdinalIgnoreCase)))
                .OrderByDescending(p => p.StockOnHand * p.Price)
                .ThenBy(p => p.Name)
                .ToList();
        }
    }

    private void ShowInfo(string text) { Message = text; MessageIsError = false; }

    private void ShowError(string text) { Message = text; MessageIsError = true; }
