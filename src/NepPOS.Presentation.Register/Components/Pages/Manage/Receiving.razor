@page "/manage/receiving"
@layout ManageLayout
@using NepPOS.Application.Catalog
@using NepPOS.Application.Scanning
@using NepPOS.Application.Stock
@using NepPOS.Domain.Entities
@using NepPOS.Domain.Enums
@using NepPOS.Presentation.Register.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IStockReceivingService Deliveries
@inject IProductCatalogService Catalog
@inject IProductManagementService ProductService
@inject ScanResolutionService Scanner
@inject CurrentUserSession Session
@inject NavigationManager Nav
@inject NepPOS.Application.Licensing.LicenceGuard Licence

@if (Session.Employee is null || Session.Employee.Role < EmployeeRole.Manager)
{
    <div class="settings-denied">
        <p>Manager access required.</p>
        <button @onclick='() => Nav.NavigateTo("/register")'>Back to Register</button>
    </div>
}
else
{
    <div class="settings-shell">
        <div class="settings-topbar">
            <span class="brand-text">@(Mode switch { View.New => "New delivery", View.Detail => $"Invoice {Detail?.InvoiceNumber}", View.Posted => "Delivery received", _ => "Receive stock" })</span>
            @if (Mode is View.List or View.New)
            {
                @if (EInvoicesAllowed)
                {
                    <label class="top-save file-btn" title="The XML invoice file from the supplier (ALM / Metcash)">
                        ⬆ Import e-invoice
                        <InputFile OnChange="ImportAsync" accept=".xml,text/xml,application/xml" />
                    </label>
                }
                else
                {
                    <button class="top-save" disabled title="Supplier e-invoices aren't in this business's NepPOS plan. Contact NepPOS to add them.">⬆ Import e-invoice (not in plan)</button>
                }
            }
            @if (Mode == View.List)
            {
                <button class="add-btn" @onclick="StartNewAsync">+ New delivery</button>
            }
            else if (Mode is View.Detail or View.Posted)
            {
                @if (Mode == View.Detail && Detail is { IsReversed: false } && !Reversing)
                {
                    <button class="top-save danger" @onclick="() => Reversing = true">Reverse delivery</button>
                }
                <button class="top-save" @onclick="BackToListAsync">← All deliveries</button>
            }
        </div>

        @if (Message is not null)
        {
            <div class="msg @(IsError ? "error" : "")">@Message</div>
        }

        @if (FileInvoices.Count > 1)
        {
            <div class="rc-body rc-pick">
                <section class="rc-card">
                    <h2>This file has @FileInvoices.Count invoices. Which one arrived?</h2>
                    <div class="rc-choices">
                        @foreach (var inv in FileInvoices)
                        {
                            <button class="rc-choice" @onclick="() => LoadInvoiceAsync(inv)">@inv.InvoiceNumber <span class="muted">@inv.InvoiceDate.ToString("d MMM") · @inv.Lines.Count lines · @inv.CostExGst.ToString("C")</span></button>
                        }
                    </div>
                </section>
            </div>
        }

        @switch (Mode)
        {
            case View.List:
                <div class="rc-body">
                    @if (Recent.Count == 0)
                    {
                        <div class="rc-empty">
                            <h2>No deliveries yet</h2>
                            <p>When stock arrives, tap <strong>New delivery</strong>: pick the supplier, enter the invoice number and scan each product. Stock goes up and costs and margins update.</p>
                            <button class="big-btn primary" @onclick="StartNewAsync">+ New delivery</button>
                        </div>
                    }
                    else
                    {
                        <table class="rc-table">
                            <thead><tr><th>Received</th><th>Supplier</th><th>Invoice</th><th class="num">Lines</th><th class="num">Cost ex GST</th><th>By</th></tr></thead>
                            <tbody>
                                @foreach (var r in Recent)
                                {
                                    <tr class="click @(r.Reversed ? "reversed" : "")" @onclick="() => OpenAsync(r.Id)">
                                        <td>@r.PostedUtc.ToLocalTime().ToString("ddd d MMM, h:mm tt")</td>
                                        <td>@r.SupplierName</td>
                                        <td>@r.InvoiceNumber <span class="muted">@r.InvoiceDate.ToString("d MMM")</span>@if (r.Reversed) { <span class="tag-reversed">Reversed</span> }</td>
                                        <td class="num">@r.Lines</td>
                                        <td class="num cost">@r.TotalCost.ToString("C")</td>
                                        <td class="muted">@r.EmployeeName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                break;

            case View.New:
                <div class="rc-body">
                    <section class="rc-card rc-head">
                        <label>Supplier
                            @if (AddingSupplier)
                            {
                                <span class="inline">
                                    <input @bind="NewSupplierName" placeholder="Supplier name" />
                                    <button class="chip primary" @onclick="AddSupplierAsync">Add</button>
                                    <button class="chip" @onclick="() => AddingSupplier = false">Cancel</button>
                                </span>
                            }
                            else
                            {
                                <span class="inline">
                                    <select @bind="SupplierId">
                                        <option value="0">@(AddingImportedSupplier || (Imported is not null && Imported.SupplierId is null) ? $"New: {Imported!.SupplierName}" : "Choose…")</option>
                                        @foreach (var s in Suppliers)
                                        {
                                            <option value="@s.Id">@s.Name</option>
                                        }
                                    </select>
                                    <button class="chip" @onclick="() => AddingSupplier = true">+ New supplier</button>
                                </span>
                            }
                        </label>
                        <label>Invoice number <input @bind="InvoiceNumber" placeholder="As on the invoice" /></label>
                        <label>Invoice date <input type="date" @bind="InvoiceDate" /></label>
                        @if (AddingImportedSupplier)
                        {
                            <p class="rc-note">@Imported!.SupplierName is new to NepPOS. It's added as a supplier when you post@(string.IsNullOrEmpty(Imported.Invoice.AccountNumber) ? "" : $", with your account number {Imported.Invoice.AccountNumber}"). Already set up under another name? Choose it above.</p>
                        }
                    </section>

                    @if (Unmatched.Count > 0)
                    {
                        <section class="rc-card rc-attention">
                            <h2>@Unmatched.Count invoice line@(Unmatched.Count == 1 ? "" : "s") not in your products</h2>
                            <p class="muted">Link each one to a product (NepPOS remembers it for next time), create it, or skip it. You can post once they're all done.</p>
                            @foreach (var pending in Unmatched)
                            {
                                var l = pending.Line;
                                <div class="rc-pending">
                                    <div class="rc-pending-head">
                                        <div>
                                            <strong>@l.Description</strong>
                                            <div class="muted">@Imported!.SupplierName @l.ItemCode@(l.Barcode is null ? "" : $" · barcode {l.Barcode}") · @UnitsText(l) · @l.CostExGst.ToString("C") ex GST</div>
                                        </div>
                                        <div class="rc-pending-actions">
                                            <button class="chip @(pending.Mode == PendingMode.Link ? "primary" : "")" @onclick="() => pending.Mode = PendingMode.Link">Link to product</button>
                                            <button class="chip @(pending.Mode == PendingMode.Create ? "primary" : "")" @onclick="() => StartCreate(pending)">New product</button>
                                            <button class="chip" @onclick="() => Skip(pending)">Skip</button>
                                        </div>
                                    </div>

                                    @if (pending.Mode == PendingMode.Link)
                                    {
                                        <form class="rc-add" @onsubmit="() => SearchForAsync(pending)">
                                            <input @bind="pending.Search" placeholder="Scan the product, type its PLU or search by name" />
                                            <button type="submit" class="chip primary">Find</button>
                                        </form>
                                        @if (l.BarcodeMultiple > 1)
                                        {
                                            <label class="rc-check"><input type="checkbox" @bind="pending.IsMultiPack" /> The product I pick is the @l.BarcodeMultiple-pack (sold as one item)</label>
                                        }
                                        @if (pending.Choices.Count > 0)
                                        {
                                            <div class="rc-choices">
                                                @foreach (var p in pending.Choices)
                                                {
                                                    <button class="rc-choice" @onclick="() => LinkAsync(pending, p)">@p.Name <span class="muted">@p.Plu</span></button>
                                                }
                                            </div>
                                        }
                                        else if (pending.Searched)
                                        {
                                            <p class="muted">Nothing found. Try another word, or create it as a new product.</p>
                                        }
                                    }
                                    else if (pending.Mode == PendingMode.Create)
                                    {
                                        var cost = l.UnitCostExGst * pending.NewUnitsPerSingle;
                                        var gp = StockMath.GrossProfitPercent(pending.NewPrice, 1, cost, false);
                                        <div class="rc-create">
                                            <label>Name <input @bind="pending.NewName" /></label>
                                            <label>Department <input @bind="pending.NewCategory" list="rc-departments" /></label>
                                            <label>Sell price <input type="number" min="0" step="0.01" @bind="pending.NewPrice" @bind:event="oninput" /></label>
                                            <div class="rc-create-gp">
                                                <span class="muted">Cost @cost.ToString("C") ex GST</span>
                                                <span class="gp @StockMath.MarginLevel(gp)">GP @(gp is null ? "—" : $"{gp:0.#}%")</span>
                                            </div>
                                            <button class="chip primary" @onclick="() => CreateAsync(pending)" disabled="@Busy">Create and add</button>
                                        </div>
                                    }
                                </div>
                            }
                            <datalist id="rc-departments">
                                @foreach (var d in Departments)
                                {
                                    <option value="@d"></option>
                                }
                            </datalist>
                        </section>
                    }

                    <section class="rc-card">
                        <form class="rc-add" @onsubmit="AddByCodeAsync">
                            <input @bind="Code" placeholder="Scan a barcode, type a PLU or search by name" autofocus />
                            <button type="submit" class="chip primary">Add</button>
                        </form>

                        @if (Choices.Count > 0)
                        {
                            <div class="rc-choices">
                                @foreach (var p in Choices)
                                {
                                    <button class="rc-choice" @onclick="() => AddProductAsync(p, null)">@p.Name <span class="muted">@p.Plu</span></button>
                                }
                            </div>
                        }

                        @if (Lines.Count == 0)
                        {
                            <p class="muted rc-hint">Scan each product on the invoice. A pack's barcode adds that pack (a case of 24 adds 24).</p>
                        }
                        else
                        {
                            <table class="rc-table lines">
                                <thead><tr><th>Product</th><th>Pack</th><th class="num">Qty</th><th class="num">Cost per pack<br /><span class="muted">ex GST</span></th><th class="num">Line</th><th class="num">Stock after</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var line in Lines)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@line.Product.Name</strong>
                                                <div class="muted">@line.Product.Plu · on hand @line.Product.StockOnHand.ToString("0.##")@(line.SupplierItemCode is null ? "" : $" · {Imported?.SupplierName} {line.SupplierItemCode}")</div>
                                                @if (line.Note is not null)
                                                {
                                                    <div class="rc-sub">@line.Note</div>
                                                }
                                                @if (line.Source is not null)
                                                {
                                                    <button class="link-btn" @onclick="() => ChangeProduct(line)">Wrong product? Change it</button>
                                                }
                                            </td>
                                            <td>
                                                <select value="@line.PackUnits" @onchange="e => ChangePack(line, e.Value)">
                                                    <option value="1">Single</option>
                                                    @foreach (var pack in line.Packs)
                                                    {
                                                        <option value="@pack.UnitQuantity">@pack.DisplayName</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="num"><input class="qty" type="number" min="0" step="1" @bind="line.Quantity" /></td>
                                            <td class="num">
                                                <input class="cost" type="number" min="0" step="0.01" @bind="line.CostPerPack" />
                                                @if (line.WasPerPack is { } was && Math.Abs(was - line.CostPerPack) >= 0.01m)
                                                {
                                                    <div class="@(line.CostPerPack > was ? "up" : "down")">was @was.ToString("C")</div>
                                                }
                                            </td>
                                            <td class="num">@((line.Quantity * line.CostPerPack).ToString("C"))</td>
                                            <td class="num">@((line.Product.StockOnHand + line.Quantity * line.PackUnits).ToString("0.##"))</td>
                                            <td><button class="chip danger" title="Remove" @onclick="() => Lines.Remove(line)">✕</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </section>

                    @if (Skipped.Count > 0 || NotSupplied.Count > 0)
                    {
                        <section class="rc-card rc-skipped">
                            @foreach (var pending in Skipped)
                            {
                                <div class="rc-skip-row">
                                    <span><strong>Skipped:</strong> @pending.Line.Description <span class="muted">@UnitsText(pending.Line) · @pending.Line.CostExGst.ToString("C")</span></span>
                                    @if (pending.AutoSkipped)
                                    {
                                        <span class="muted">always skipped</span>
                                    }
                                    else
                                    {
                                        <label class="rc-check"><input type="checkbox" @bind="pending.AlwaysSkip" /> Always skip</label>
                                    }
                                    <button class="chip" @onclick="() => Unskip(pending)">Undo</button>
                                </div>
                            }
                            @foreach (var line in NotSupplied)
                            {
                                <div class="rc-skip-row"><span><strong>Not supplied:</strong> @line.Description <span class="muted">@line.ItemCode</span></span></div>
                            }
                        </section>
                    }

                    <div class="rc-foot">
                        <div class="rc-totals">
                            <span><strong>@Lines.Count</strong> lines</span>
                            <span><strong>@Lines.Sum(l => l.Quantity * l.PackUnits).ToString("0.##")</strong> singles</span>
                            <span><strong>@Lines.Sum(l => l.Quantity * l.CostPerPack).ToString("C")</strong> ex GST</span>
                            @if (Imported is not null)
                            {
                                <span class="muted">invoice @Imported.Invoice.CostExGst.ToString("C")@(Skipped.Count > 0 ? $", skipped {Skipped.Sum(p => p.Line.CostExGst):C}" : "")</span>
                            }
                        </div>
                        <button class="big-btn" @onclick="BackToListAsync" disabled="@Busy">Cancel</button>
                        @if (Confirming)
                        {
                            <button class="big-btn primary" @onclick="PostAsync" disabled="@Busy">@(Busy ? "Posting…" : "Yes, post it")</button>
                        }
                        else
                        {
                            <button class="big-btn primary" @onclick="AskToPost" disabled="@(Lines.Count == 0 || Unmatched.Count > 0)">Post delivery</button>
                        }
                    </div>
                    @if (Confirming)
                    {
                        <p class="rc-confirm">Stock and costs update straight away and a posted delivery can't be edited. Mistakes are fixed with a stock adjustment.</p>
                    }
                </div>
                break;

            case View.Posted when Posted is not null:
                <div class="rc-body">
                    <section class="rc-card rc-done">
                        <h2>@Posted.Singles.ToString("0.##") singles received · @Posted.TotalCost.ToString("C") ex GST</h2>
                        <p class="muted">Stock and costs are updated. Each line is in the stock ledger as "Invoice @LastInvoice".</p>
                    </section>

                    @if (Posted.CostChanges.Count > 0)
                    {
                        <section class="rc-card">
                            <h2>Cost changed on @Posted.CostChanges.Count product(s)</h2>
                            <p class="muted">Check the price still leaves enough margin. Change prices in Products &amp; PLUs.</p>
                            <table class="rc-table">
                                <thead><tr><th>Product</th><th class="num">Cost per single</th><th class="num">Price</th><th class="num">GP%</th></tr></thead>
                                <tbody>
                                    @foreach (var c in Posted.CostChanges)
                                    {
                                        <tr>
                                            <td>@c.ProductName</td>
                                            <td class="num">@c.OldCost?.ToString("C") → <strong class="@(c.NewCost > c.OldCost ? "up" : "down")">@c.NewCost.ToString("C")</strong></td>
                                            <td class="num">@c.Price.ToString("C")</td>
                                            <td class="num">@Gp(c.GpBefore) → <span class="gp @StockMath.MarginLevel(c.GpAfter)">@Gp(c.GpAfter)</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <button class="big-btn" @onclick='() => Nav.NavigateTo("/manage/plu")'>Go to Products &amp; PLUs</button>
                        </section>
                    }
                </div>
                break;

            case View.Detail when Detail is not null:
                <div class="rc-body">
                    @if (Detail.ReversedUtc is { } reversedAt)
                    {
                        <section class="rc-card rc-reversed">
                            <h2>Reversed</h2>
                            <p>@reversedAt.ToLocalTime().ToString("ddd d MMM yyyy, h:mm tt")@(Detail.ReversedBy is null ? "" : " by " + Detail.ReversedBy): @Detail.ReversalReason. This delivery's stock was taken back out and its costs put back. It's kept here for the record.</p>
                        </section>
                    }
                    else if (Reversing)
                    {
                        <section class="rc-card rc-reverse">
                            <h2>Reverse this delivery?</h2>
                            <p>Takes <strong>@Detail.Lines.Sum(l => l.Singles).ToString("0.##") singles</strong> back out of stock and puts each product's cost back to what it was before. Invoice @Detail.InvoiceNumber can then be imported or entered again, correctly.</p>
                            <div class="rc-reasons">
                                @foreach (var r in ReverseReasons)
                                {
                                    <button class="chip @(ReverseReason == r ? "primary" : "")" @onclick="() => ReverseReason = r">@r</button>
                                }
                            </div>
                            <label class="rc-reason-text">Or type the reason <input @bind="ReverseReason" @bind:event="oninput" maxlength="200" /></label>
                            <div class="rc-reverse-actions">
                                <button class="big-btn" @onclick="() => (Reversing, ReverseReason) = (false, string.Empty)" disabled="@Busy">Keep it</button>
                                <button class="big-btn danger" @onclick="ReverseAsync" disabled="@(Busy || string.IsNullOrWhiteSpace(ReverseReason))">@(Busy ? "Reversing…" : "Reverse delivery")</button>
                            </div>
                        </section>
                    }
                    <section class="rc-card">
                        <h2>@Detail.SupplierName · invoice @Detail.InvoiceNumber</h2>
                        <p class="muted">Invoice date @Detail.InvoiceDate.ToString("d MMM yyyy") · received @Detail.PostedUtc.ToLocalTime().ToString("d MMM yyyy h:mm tt")@(Detail.EmployeeName is null ? "" : " by " + Detail.EmployeeName)</p>
                        <table class="rc-table">
                            <thead><tr><th>Product</th><th>Pack</th><th class="num">Qty</th><th class="num">Cost per pack</th><th class="num">Line</th><th class="num">Cost per single</th></tr></thead>
                            <tbody>
                                @foreach (var l in Detail.Lines)
                                {
                                    <tr>
                                        <td>@l.ProductName</td>
                                        <td>@l.PackName</td>
                                        <td class="num">@l.Quantity.ToString("0.##")</td>
                                        <td class="num">@l.CostPerPack.ToString("C")</td>
                                        <td class="num">@l.LineCost.ToString("C")</td>
                                        <td class="num">@if (l.PreviousUnitCost is { } prev && Math.Abs(prev - l.UnitCost) >= 0.005m) { <span class="muted">@prev.ToString("C") → </span> }@l.UnitCost.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot><tr><td colspan="4">Total ex GST</td><td class="num"><strong>@Detail.Lines.Sum(l => l.LineCost).ToString("C")</strong></td><td></td></tr></tfoot>
                        </table>
                    </section>
                </div>
                break;
        }
    </div>
}

@code {
    private enum View { List, New, Posted, Detail }

    private View Mode = View.List;
    private string? Message;
    private bool IsError;
    private bool Busy;
    private bool Confirming;

    private IReadOnlyList<ReceiptSummary> Recent = Array.Empty<ReceiptSummary>();
    private IReadOnlyList<Supplier> Suppliers = Array.Empty<Supplier>();
    private StockReceipt? Detail;
    private ReceiptPosted? Posted;
    private string LastInvoice = "";

    // The delivery being entered.
    private int SupplierId;
    private bool AddingSupplier;
    private string NewSupplierName = "";
    private string InvoiceNumber = "";
    private DateTime InvoiceDate = DateTime.Today;
    private string Code = "";
    private List<Product> Choices = new();
    private List<Line> Lines = new();

    // E-invoice import.
    private IReadOnlyList<SupplierInvoice> FileInvoices = Array.Empty<SupplierInvoice>();
    private InvoiceMatchResult? Imported;
    private List<Pending> Unmatched = new();
    private List<Pending> Skipped = new();
    private List<SupplierInvoiceLine> NotSupplied = new();
    private IReadOnlyList<string> Departments = Array.Empty<string>();

    /// <summary>The imported invoice's supplier is new and no existing supplier has been chosen instead.</summary>
    private bool AddingImportedSupplier => Imported is { SupplierId: null } && SupplierId == 0;

    private enum PendingMode { None, Link, Create }

    /// <summary>An invoice line with no product yet.</summary>
    private sealed class Pending
    {
        public required SupplierInvoiceLine Line { get; init; }
        public PendingMode Mode { get; set; }
        public string Search { get; set; } = "";
        public bool Searched { get; set; }
        public List<Product> Choices { get; set; } = new();
        public bool IsMultiPack { get; set; }
        public string NewName { get; set; } = "";
        public string NewCategory { get; set; } = "";
        public decimal NewPrice { get; set; }
        public int NewUnitsPerSingle => Math.Max(1, Line.BarcodeMultiple);
        public bool AlwaysSkip { get; set; }
        public bool AutoSkipped { get; init; }
    }

    private sealed class Line
    {
        public required Product Product { get; init; }
        public required IReadOnlyList<ProductVariant> Packs { get; init; }
        public int PackUnits { get; set; } = 1;
        public decimal Quantity { get; set; } = 1;
        public decimal CostPerPack { get; set; }

        /// <summary>What this pack cost last time (last cost × singles), to show when the invoice differs.</summary>
        public decimal? WasPerPack => (Product.LastCost ?? Product.CostPrice) is { } single ? Math.Round(single * PackUnits, 2) : null;

        public string? SupplierItemCode { get; init; }
        /// <summary>The e-invoice line this came from, so it can be matched to a different product.</summary>
        public SupplierInvoiceLine? Source { get; init; }
        public int UnitsPerSingle { get; init; } = 1;
        public string? Note { get; init; }

        public string PackName => PackUnits == 1 ? "Single" : Packs.FirstOrDefault(p => p.UnitQuantity == PackUnits)?.DisplayName ?? $"Pack of {PackUnits}";
    }

    protected override Task OnInitializedAsync() => BackToListAsync();

    private async Task BackToListAsync()
    {
        (Mode, Message, Confirming, Detail, Posted) = (View.List, null, false, null, null);
        Recent = await Deliveries.GetRecentAsync();
    }

    private async Task StartNewAsync()
    {
        (Mode, Message, Confirming) = (View.New, null, false);
        Suppliers = await Deliveries.GetSuppliersAsync();
        (SupplierId, InvoiceNumber, InvoiceDate, Code, AddingSupplier) = (0, "", DateTime.Today, "", false);
        Lines = new();
        Choices = new();
        (Imported, FileInvoices) = (null, Array.Empty<SupplierInvoice>());
        (Unmatched, Skipped, NotSupplied) = (new(), new(), new());
    }

    private async Task OpenAsync(int id)
    {
        (Reversing, ReverseReason, Message) = (false, "", null);
        Detail = await Deliveries.GetAsync(id);
        Mode = Detail is null ? View.List : View.Detail;
    }

    private async Task AddSupplierAsync()
    {
        if (string.IsNullOrWhiteSpace(NewSupplierName)) return;
        var supplier = await Deliveries.AddSupplierAsync(NewSupplierName);
        Suppliers = await Deliveries.GetSuppliersAsync();
        (SupplierId, AddingSupplier, NewSupplierName) = (supplier.Id, false, "");
    }

    /// <summary>A barcode or PLU adds straight away (a pack's barcode adds that pack); a name shows matches to pick from.</summary>
    private async Task AddByCodeAsync()
    {
        var code = Code.Trim();
        (Message, Choices) = (null, new());
        if (code.Length == 0) return;

        var found = await Scanner.ResolveAsync(code);
        switch (found.Payload)
        {
            case Product product:
                await AddProductAsync(product, null);
                return;
            case ProductVariant pack:
                await AddProductAsync(pack.Product, pack.UnitQuantity);
                return;
        }

        var matches = await Catalog.SearchAsync(code, 20);
        if (matches.Count == 1)
            await AddProductAsync(matches[0], null);
        else if (matches.Count == 0)
            Show($"Nothing matches \"{code}\". Add the product in Products & PLUs first.", error: true);
        else
            Choices = matches.ToList();
    }

    private async Task AddProductAsync(Product product, int? packUnits)
    {
        Choices = new();
        Code = "";

        // Same product and pack again: one more of it, not a second line.
        var packs = await Deliveries.GetPacksAsync(product.Id);
        var units = packUnits ?? packs.LastOrDefault()?.UnitQuantity ?? 1;   // deliveries usually come by the case
        var existing = Lines.FirstOrDefault(l => l.Product.Id == product.Id && l.PackUnits == units);
        if (existing is not null)
        {
            existing.Quantity++;
            return;
        }

        var line = new Line { Product = product, Packs = packs, PackUnits = units };
        line.CostPerPack = line.WasPerPack ?? 0;
        Lines.Insert(0, line);
    }

    private static void ChangePack(Line line, object? value)
    {
        if (!int.TryParse(value?.ToString(), out var units) || units < 1) return;
        var single = line.PackUnits == 0 ? 0 : line.CostPerPack / line.PackUnits;
        line.PackUnits = units;
        line.CostPerPack = Math.Round(single * units, 2);
    }

    private void AskToPost()
    {
        if (!AddingImportedSupplier && Suppliers.All(s => s.Id != SupplierId)) { Show("Choose the supplier.", error: true); return; }
        if (string.IsNullOrWhiteSpace(InvoiceNumber)) { Show("Enter the invoice number.", error: true); return; }
        if (Lines.Any(l => l.Quantity <= 0)) { Show("Every line needs a quantity. Remove lines you didn't receive.", error: true); return; }
        if (Unmatched.Count > 0) { Show("Some invoice lines aren't in your products yet: link, create or skip them.", error: true); return; }
        Message = null;
        Confirming = true;
    }

    private async Task PostAsync()
    {
        var supplier = Suppliers.FirstOrDefault(s => s.Id == SupplierId);
        if ((supplier is null && !AddingImportedSupplier) || Busy) return;

        Busy = true;
        try
        {
            var input = new ReceiptInput(supplier?.Id, supplier?.Name ?? Imported!.SupplierName, InvoiceNumber, DateOnly.FromDateTime(InvoiceDate),
                Lines.Select(l => new ReceiptLineInput(l.Product.Id, l.PackUnits, l.PackName, l.Quantity, l.CostPerPack)
                {
                    SupplierItemCode = l.SupplierItemCode,
                    SupplierUnitsPerSingle = l.UnitsPerSingle
                }).ToList())
            {
                AddSupplier = AddingImportedSupplier,
                SupplierAccountNumber = Imported?.Invoice.AccountNumber,
                SkipAlways = Skipped.Where(p => p.AlwaysSkip && !p.AutoSkipped).Select(p => new SkipItem(p.Line.ItemCode, p.Line.Description)).ToList()
            };
            Posted = await Deliveries.PostAsync(input, Session.Employee?.FullName);
            LastInvoice = InvoiceNumber.Trim();
            (Mode, Confirming, Message) = (View.Posted, false, null);
        }
        catch (InvalidOperationException ex)
        {
            Confirming = false;
            Show(ex.Message, error: true);
        }
        catch (Exception)
        {
            Confirming = false;
            Show("The delivery didn't save, so nothing changed. Details are in the log file.", error: true);
        }
        finally
        {
            Busy = false;
        }
    }

    /// <summary>Reads the supplier's XML file. One invoice loads straight away; several ask which one.</summary>
    /// <summary>
    /// The plan decides. Before the first licence arrives (new or not yet activated register) it's allowed,
    /// like the rest of a trial.
    /// </summary>
    private bool EInvoicesAllowed => Licence.Claims is not { } claims || claims.Has(NepPOS.Contracts.Licensing.LicenceFeatures.EInvoices);

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        Message = null;
        if (!EInvoicesAllowed)
        {
            Show("Supplier e-invoices aren't in this business's NepPOS plan. Enter the delivery by hand, or contact NepPOS to add them.", error: true);
            return;
        }
        try
        {
            // The browser's file stream is async-only: copy it before the XML reader reads it.
            using var copy = new MemoryStream();
            await using (var upload = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024))
                await upload.CopyToAsync(copy);
            copy.Position = 0;

            var invoices = SupplierInvoiceReader.Read(copy);
            if (invoices.Count == 1)
                await LoadInvoiceAsync(invoices[0]);
            else
                FileInvoices = invoices;
        }
        catch (InvalidDataException ex)
        {
            Show(ex.Message, error: true);
        }
        catch (IOException)
        {
            Show("That file is too big for an invoice (over 10 MB).", error: true);
        }
    }

    private async Task LoadInvoiceAsync(SupplierInvoice invoice)
    {
        FileInvoices = Array.Empty<SupplierInvoice>();
        var match = await Deliveries.MatchInvoiceAsync(invoice);
        if (match.AlreadyReceived)
        {
            Show($"Invoice {invoice.InvoiceNumber} from {match.SupplierName} has already been received.", error: true);
            return;
        }

        await StartNewAsync();
        Imported = match;
        Departments = await Catalog.GetCategoriesAsync();
        (SupplierId, InvoiceNumber, InvoiceDate) = (match.SupplierId ?? 0, invoice.InvoiceNumber, invoice.InvoiceDate.ToDateTime(TimeOnly.MinValue));

        foreach (var result in match.Lines)
        {
            switch (result.MatchedBy)
            {
                case InvoiceLineMatch.SupplierCode or InvoiceLineMatch.Barcode:
                    await AddInvoiceLineAsync(result.Product!, result.Line, result.UnitsPerSingle);
                    break;
                case InvoiceLineMatch.Skipped:
                    Skipped.Add(new Pending { Line = result.Line, AlwaysSkip = true, AutoSkipped = true });
                    break;
                case InvoiceLineMatch.NotSupplied:
                    NotSupplied.Add(result.Line);
                    break;
                default:
                    Unmatched.Add(new Pending { Line = result.Line });
                    break;
            }
        }

        var known = Lines.Count;
        Show(Unmatched.Count == 0
            ? $"Invoice {invoice.InvoiceNumber} loaded: {known} line{(known == 1 ? "" : "s")}. Check the quantities against the delivery, then post."
            : $"Invoice {invoice.InvoiceNumber} loaded: {known} line{(known == 1 ? "" : "s")} matched, {Unmatched.Count} to sort out below.");
    }

    /// <summary>
    /// Adds an invoice line as a delivery line: in whole cases when the product has that case as a pack,
    /// otherwise in singles. The line's cost before GST is kept exactly.
    /// </summary>
    private async Task AddInvoiceLineAsync(Product product, SupplierInvoiceLine line, int unitsPerSingle)
    {
        unitsPerSingle = Math.Max(1, unitsPerSingle);
        var packs = await Deliveries.GetPacksAsync(product.Id);
        var singles = line.Units / unitsPerSingle;
        var caseSingles = line.CasePack % unitsPerSingle == 0 ? line.CasePack / unitsPerSingle : 0;
        var useCase = caseSingles > 1 && singles % caseSingles == 0 && packs.Any(v => v.UnitQuantity == caseSingles);

        var packUnits = useCase ? caseSingles : 1;
        var quantity = singles / packUnits;
        Lines.Add(new Line
        {
            Product = product,
            Packs = packs,
            PackUnits = packUnits,
            Quantity = quantity,
            CostPerPack = quantity == 0 ? 0 : Math.Round(line.CostExGst / quantity, 4),
            SupplierItemCode = line.ItemCode,
            Source = line,
            UnitsPerSingle = unitsPerSingle,
            Note = line.IsSubstitute ? $"Substitute: you ordered {line.OrderedItemCode}. Check the shelf price." : null
        });
    }

    private async Task SearchForAsync(Pending pending)
    {
        var code = pending.Search.Trim();
        if (code.Length == 0) return;

        var found = await Scanner.ResolveAsync(code);
        switch (found.Payload)
        {
            case Product product:
                await LinkAsync(pending, product);
                return;
            case ProductVariant pack:
                await LinkAsync(pending, pack.Product);
                return;
        }

        pending.Choices = (await Catalog.SearchAsync(code, 20)).ToList();
        pending.Searched = true;
    }

    private async Task LinkAsync(Pending pending, Product product)
    {
        Unmatched.Remove(pending);
        await AddInvoiceLineAsync(product, pending.Line, pending.IsMultiPack ? pending.Line.BarcodeMultiple : 1);
    }

    private void StartCreate(Pending pending)
    {
        pending.Mode = PendingMode.Create;
        if (pending.NewName.Length == 0)
            pending.NewName = pending.Line.Description;
    }

    /// <summary>Creates the product now (with the invoice's barcode), then adds its line to the delivery.</summary>
    private async Task CreateAsync(Pending pending)
    {
        if (string.IsNullOrWhiteSpace(pending.NewName)) { Show("Give the new product a name.", error: true); return; }
        if (pending.NewPrice <= 0) { Show($"Enter a sell price for {pending.NewName}.", error: true); return; }

        Busy = true;
        try
        {
            var product = await ProductService.CreateAsync(new Product
            {
                Name = pending.NewName.Trim(),
                Category = pending.NewCategory.Trim(),
                Price = pending.NewPrice,
                Barcode = pending.Line.Barcode,
                IsActive = true
            });
            Unmatched.Remove(pending);
            await AddInvoiceLineAsync(product, pending.Line, pending.NewUnitsPerSingle);
            Message = null;
        }
        catch (Exception)
        {
            Show($"{pending.NewName} couldn't be created. Details are in the log file.", error: true);
        }
        finally
        {
            Busy = false;
        }
    }

    /// <summary>Puts an imported line back to "not matched", so it can be linked to the right product (remembered on posting).</summary>
    private void ChangeProduct(Line line)
    {
        Lines.Remove(line);
        Unmatched.Add(new Pending { Line = line.Source!, Mode = PendingMode.Link });
        Confirming = false;
    }

    private static readonly string[] ReverseReasons = { "Wrong quantities", "Wrong products", "Wrong supplier or invoice", "Entered twice" };
    private bool Reversing;
    private string ReverseReason = "";

    private async Task ReverseAsync()
    {
        if (Detail is null || Busy) return;

        Busy = true;
        try
        {
            var result = await Deliveries.ReverseAsync(Detail.Id, ReverseReason, Session.Employee?.FullName);
            var invoice = Detail.InvoiceNumber;
            (Reversing, ReverseReason) = (false, "");
            Detail = await Deliveries.GetAsync(Detail.Id);
            Show($"Invoice {invoice} reversed: {result.Singles:0.##} singles taken back out of stock and costs put back. Import or enter it again with the right details."
                + (result.NegativeStock.Count == 0 ? "" : $" Now below zero (some was already sold): {string.Join(", ", result.NegativeStock)}."));
        }
        catch (InvalidOperationException ex)
        {
            Show(ex.Message, error: true);
        }
        catch (Exception)
        {
            Show("The delivery wasn't reversed, so nothing changed. Details are in the log file.", error: true);
        }
        finally
        {
            Busy = false;
        }
    }

    private void Skip(Pending pending)
    {
        Unmatched.Remove(pending);
        pending.Mode = PendingMode.None;
        Skipped.Add(pending);
    }

    private void Unskip(Pending pending)
    {
        Skipped.Remove(pending);
        Unmatched.Add(new Pending { Line = pending.Line });
    }

    /// <summary>"120 units (4 × 30)": how the invoice counts it.</summary>
    private static string UnitsText(SupplierInvoiceLine line) =>
        line.CasePack > 1 && line.Units % line.CasePack == 0
            ? $"{line.Units:0.##} units ({line.Units / line.CasePack:0.##} × {line.CasePack})"
            : $"{line.Units:0.##} units";

    private static string Gp(decimal? gp) => gp is null ? "—" : $"{gp:0.#}%";

    private void Show(string text, bool error = false) => (Message, IsError) = (text, error);
}
