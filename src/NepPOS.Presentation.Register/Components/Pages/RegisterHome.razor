@page "/register"
@layout EmptyLayout
@using NepPOS.Application.Catalog
@using NepPOS.Domain.Entities
@using NepPOS.Presentation.Register.Services
@using NepPOS.Application.Scanning
@using NepPOS.Domain.Enums
@using NepPOS.Application.Abstractions
@using NepPOS.Application.Payments
@using NepPOS.Presentation.Register.Components.Shared
@inject NavigationManager Nav
@inject IProductCatalogService Catalog
@inject CurrentUserSession Session

<div class="pos-shell">

    <div class="pos-topbar">
        <div class="topbar-left">
            <span class="brand-dot">N</span>
            <span class="brand-text">NepPOS</span>
        </div>
        <div class="topbar-categories">
            @foreach (var category in Categories)
            {
                <button class="category-pill @(category == SelectedCategory && SearchTerm is null ? "active" : "")"
                        @onclick="() => SelectCategoryAsync(category)">
                    @category
                </button>
            }
        </div>
        <div class="topbar-right">
            @if (Session.Employee?.Role >= EmployeeRole.Manager)
            {
                <button class="manage-link" @onclick='() => Nav.NavigateTo("/manage")'>Manage</button>
            }
            <span class="employee-name">@Session.Employee?.FullName</span>
            <span class="employee-role-badge">@Session.Employee?.Role</span>
        </div>
    </div>

    <div class="pos-body">

        <div class="product-grid-area">

            <div class="scan-entry-bar" @onclick="OpenScanKeyboard">
                <span class="scan-display">@(string.IsNullOrEmpty(ScanInput) ? "Tap to scan, enter a code or search by name..." : ScanInput)</span>
                @if (!string.IsNullOrEmpty(ScanError))
                {
                    <span class="scan-error">@ScanError</span>
                }
            </div>

            @if (SearchTerm is not null)
            {
                <div class="search-results-bar">
                    <span>Results for "@SearchTerm" (@Products.Count)</span>
                    <button class="search-clear" @onclick="ClearSearchAsync">Clear</button>
                </div>
            }

            <div class="product-grid">
                @foreach (var product in Products)
                {
                    <button class="product-tile" @onclick="() => AddToCart(product)">
                        <div class="product-image">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" />
                            }
                            else
                            {
                                <div class="image-placeholder">@product.Name.Substring(0, 1)</div>
                            }
                        </div>
                        <div class="product-name">@product.Name</div>
                        <div class="product-price">@product.Price.ToString("C")</div>
                    </button>
                }
            </div>

        </div>

        <div class="order-panel">
            <div class="order-header">Current Order</div>

            <div class="order-lines">
                @if (CartLines.Count == 0)
                {
                    <div class="empty-cart">
                        <span class="empty-icon">🛒</span>
                        <p>No items yet</p>
                    </div>
                }
                else
                {
                    @foreach (var line in CartLines)
                    {
                        <div class="order-line">
                            <div class="line-info">
                                <div class="line-name">@line.Name</div>
                                <div class="line-unit-price">@line.UnitPrice.ToString("C") each</div>
                            </div>
                            <div class="line-qty-controls">
                                <button @onclick="() => DecrementLine(line)">−</button>
                                <span>@line.Quantity</span>
                                <button @onclick="() => IncrementLine(line)">+</button>
                            </div>
                            <div class="line-total">@((line.UnitPrice * line.Quantity).ToString("C"))</div>
                        </div>
                    }
                }
            </div>

            <div class="order-footer">
                <div class="summary-row">
                    <span>Total</span>
                    <span>@GrandTotal.ToString("C")</span>
                </div>

                <div class="function-buttons">
                    <button class="fn-btn fn-secondary" @onclick="ClearCart" disabled="@(CartLines.Count == 0)">Void</button>
                    <button class="fn-btn fn-secondary" disabled="@(CartLines.Count == 0)">Hold</button>
                </div>
                <button class="fn-btn fn-primary" disabled="@(CartLines.Count == 0)" @onclick="OpenCharge">
                    Charge @GrandTotal.ToString("C")
                </button>
            </div>
        </div>

    </div>

    @if (ActiveSale is not null)
    {
        <TenderPanel Sale="ActiveSale"
                     CompleteSale="CompleteSaleAsync"
                     OnFinished="FinishSale"
                     OnCancel="CancelCharge" />
    }
</div>

@code {
    private IReadOnlyList<string> Categories = new List<string>();
    private IReadOnlyList<Product> Products = new List<Product>();
    private string? SelectedCategory;

    // Non-null while the grid is showing name-search results instead of a category.
    private string? SearchTerm;

    private List<CartLine> CartLines = new();
    private decimal GrandTotal => CartLines.Sum(l => l.UnitPrice * l.Quantity);

    [Inject] private ScanResolutionService ScanResolver { get; set; } = default!;
    [Inject] private OnScreenKeyboardService Keyboard { get; set; } = default!;
    [Inject] private ICheckoutService Checkout { get; set; } = default!;
    [Inject] private RegisterTerminal Terminal { get; set; } = default!;

    // Every product is GST-taxable at 10% for now.
    // TODO: per-product GST flag (GST-free items) once Product has one.
    private const decimal GstRate = 0.10m;

    // The sale being paid for while the tender panel is open; null otherwise.
    private SaleTransaction? ActiveSale;

    private string ScanInput = string.Empty;
    private string? ScanError;

    protected override async Task OnInitializedAsync()
    {
        Categories = await Catalog.GetCategoriesAsync();
        if (Categories.Count > 0)
        {
            await SelectCategoryAsync(Categories[0]);
        }
    }

    private async Task SelectCategoryAsync(string category)
    {
        SearchTerm = null;
        SelectedCategory = category;
        Products = await Catalog.GetProductsByCategoryAsync(category);
    }

    private async Task ClearSearchAsync()
    {
        SearchTerm = null;
        ScanError = null;

        if (SelectedCategory is not null)
        {
            await SelectCategoryAsync(SelectedCategory);
        }
        else
        {
            Products = new List<Product>();
        }
    }

    private void AddToCart(Product product) =>
        AddLine($"P:{product.Id}", SkuFor(product.Plu, product.Barcode, $"P{product.Id}"),
                product, product.Name, product.Price);

    // A pack size (6-pack, carton…) sells at its own price but is still the same base product.
    private void AddToCart(ProductVariant variant) =>
        AddLine($"V:{variant.Id}", SkuFor(variant.Plu, variant.Barcode, $"V{variant.Id}"),
                variant.Product, $"{variant.Product.Name} ({variant.PackType})", variant.Price);

    // PLU first, then barcode, then the internal id — PLU-screen edits can leave "" rather than null.
    private static string SkuFor(string? plu, string? barcode, string fallback) =>
        !string.IsNullOrWhiteSpace(plu) ? plu
        : !string.IsNullOrWhiteSpace(barcode) ? barcode
        : fallback;

    private void AddLine(string key, string sku, Product product, string name, decimal unitPrice)
    {
        var existing = CartLines.FirstOrDefault(l => l.Key == key);
        if (existing is not null)
        {
            existing.Quantity++;
        }
        else
        {
            CartLines.Add(new CartLine { Key = key, Sku = sku, Product = product, Name = name, UnitPrice = unitPrice, Quantity = 1 });
        }
    }

    // ---- Charge ----

    private void OpenCharge()
    {
        if (CartLines.Count == 0 || GrandTotal <= 0) return;

        // Build the sale from the cart. Its GUID goes to the EFTPOS terminal as the reference.
        var sale = new SaleTransaction(Terminal.StoreId, Terminal.RegisterId);
        foreach (var line in CartLines)
        {
            sale.AddLineItem(new SaleLineItem(line.Sku, line.Name, line.Quantity, line.UnitPrice, GstRate));
        }

        ActiveSale = sale;
    }

    // Called by the tender panel once fully paid. If it throws, the panel shows "Retry Save".
    private Task<long> CompleteSaleAsync(TenderSession tender) =>
        Checkout.CompleteSaleAsync(ActiveSale!, tender);

    private void FinishSale()
    {
        ActiveSale = null;
        CartLines.Clear();
        ScanError = null;
    }

    // Back to Order before any payment: the sale was never saved, the cart is untouched.
    private void CancelCharge() => ActiveSale = null;

    private void IncrementLine(CartLine line) => line.Quantity++;

    private void DecrementLine(CartLine line)
    {
        line.Quantity--;
        if (line.Quantity <= 0)
        {
            CartLines.Remove(line);
        }
    }

    private void ClearCart() => CartLines.Clear();

    private void OpenScanKeyboard()
    {
        Keyboard.RequestInput(
            initialValue: ScanInput,
            numericOnly: false,
            onValueChanged: value => { ScanInput = value; InvokeAsync(StateHasChanged); },
            onSubmit: () => _ = ProcessScanAsync()
        );
    }

    private async Task ProcessScanAsync()
    {
        var input = ScanInput.Trim();
        if (input.Length == 0) return;

        ScanError = null;

        try
        {
            // 1. Exact code first (PLU, barcode, voucher, customer card) — this is the scanner path.
            var result = await ScanResolver.ResolveAsync(input);

            if (result.Type == ScanResultType.Product)
            {
                // ProductScanResolver returns either a Product or a ProductVariant (pack-size barcode).
                switch (result.Payload)
                {
                    case ProductVariant variant:
                        AddToCart(variant);
                        break;
                    case Product product:
                        AddToCart(product);
                        break;
                }
            }
            else if (result.Type == ScanResultType.NotFound)
            {
                // 2. Not an exact code: search by name / partial code
                //    (legacy: IsNumeric → IndexSearch, otherwise SearchNameIndex).
                await SearchByNameAsync(input);
            }
        }
        catch (Exception)
        {
            ScanError = "Search failed. Please try again.";
        }

        ScanInput = string.Empty;
        StateHasChanged();
    }

    private async Task SearchByNameAsync(string term)
    {
        var matches = await Catalog.SearchAsync(term);

        switch (matches.Count)
        {
            case 0:
                ScanError = $"No match for '{term}'.";
                break;

            default:
                // Name search never auto-adds: always show matches so the cashier picks.
                SearchTerm = term;
                Products = matches;
                break;
        }
    }

    private sealed class CartLine
    {
        /// <summary>"P:{productId}" or "V:{variantId}" — the same product in two pack sizes is two lines.</summary>
        public required string Key { get; init; }
        public required string Sku { get; init; }
        public required Product Product { get; init; }
        public required string Name { get; init; }
        public required decimal UnitPrice { get; init; }
        public int Quantity { get; set; }
    }
}
