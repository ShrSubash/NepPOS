@page "/register"
@layout EmptyLayout
@using NepPOS.Application.Catalog
@using NepPOS.Domain.Entities
@using NepPOS.Presentation.Register.Services
@using NepPOS.Application.Scanning
@using NepPOS.Domain.Enums
@using NepPOS.Application.Abstractions
@using NepPOS.Application.Payments
@using NepPOS.Application.Journal
@using NepPOS.Application.Hardware
@using NepPOS.Presentation.Register.Components.Shared
@using NepPOS.Application.Sales
@inject NavigationManager Nav
@inject IProductCatalogService Catalog
@inject CurrentUserSession Session
@inject NepPOS.Application.Licensing.LicenceGuard Licence

<div class="pos-shell">

    <div class="pos-topbar">
        <div class="topbar-left">
            <span class="brand-dot">N</span>
            <span class="brand-text">NepPOS</span>
        </div>
        <div class="topbar-right">
            <HeadOfficeStatus Dark="true" />
            @if (Session.Employee?.Role >= EmployeeRole.Manager)
            {
                <button class="manage-link" @onclick='() => Nav.NavigateTo("/manage")'>Manage</button>
            }
            <span class="employee-name">@Session.Employee?.FullName</span>
            <span class="employee-role-badge">@Session.Employee?.Role</span>
            <button class="manage-link" @onclick="() => OpenReturn(null)" disabled="@Paying">Return</button>
            @if (Settings.PaymentTypes.GiftCards)
            {
                <button class="manage-link" @onclick="() => ShowGiftCard = true" disabled="@Paying">Gift card</button>
            }
            @if (DrawerEnabled)
            {
                <button class="manage-link" @onclick="NoSaleAsync" disabled="@Paying">No sale</button>
            }
            <button class="manage-link" @onclick="SignOutAsync" disabled="@Paying">Sign out</button>
        </div>
    </div>

    <LicenceBanner Dark="true" />

    <div class="pos-body">

        <div class="product-grid-area">
            @if (!Licence.CanStartSale && CartLines.Count == 0)
            {
                var lockState = Licence.Current;
                <div class="lic-lock">
                    <div class="lic-lock-card">
                        <div class="lic-lock-icon" aria-hidden="true">⛔</div>
                        <h2>New sales are paused</h2>
                        <p class="lic-lock-headline">@lockState.Headline.</p>
                        <p>@lockState.Detail</p>
                        @if (Session.Employee?.Role >= EmployeeRole.Manager)
                        {
                            <button class="lic-lock-btn" @onclick='() => Nav.NavigateTo("/manage")'>Open Manage: reports, end of day, Head Office</button>
                        }
                        else
                        {
                            <p class="lic-lock-ask">Ask the manager or owner.</p>
                        }
                    </div>
                </div>
            }
            else
            {
            <div class="grid-content">

            <div class="scan-entry-bar" @onclick="OpenScanKeyboard">
                <span class="scan-display">@(string.IsNullOrEmpty(ScanInput) ? "Tap to scan, enter a code or search by name..." : ScanInput)</span>
                @if (!string.IsNullOrEmpty(ScanError))
                {
                    <span class="scan-error">@ScanError</span>
                }
                else if (!string.IsNullOrEmpty(ScanNote))
                {
                    <span class="scan-note">@ScanNote</span>
                }
            </div>

            @if (SearchTerm is not null)
            {
                <div class="browse-head">
                    <button class="back-btn" @onclick="ClearSearchAsync">← Back</button>
                    <h2>Results for “@SearchTerm”</h2>
                    <span class="browse-count">@Products.Count</span>
                </div>
                @ProductTiles
            }
            else if (OpenDepartment is not null || OpenLetter is not null)
            {
                <div class="browse-head">
                    <button class="back-btn" @onclick="BackHome">← @(OpenDepartment is not null ? "Departments" : "A–Z")</button>
                    <h2>@(OpenDepartment is not null ? DepartmentLabel(OpenDepartment) : OpenLetter)</h2>
                    <span class="browse-count">@Products.Count @(Products.Count == 1 ? "product" : "products")</span>
                </div>
                @ProductTiles
            }
            else
            {
                @* What a shop sells most, its departments, or A–Z when it has none: big tiles, no typing. *@
                @if (Tabs.Count > 1)
                {
                    <div class="home-tabs" role="tablist">
                        @foreach (var tab in Tabs)
                        {
                            <button role="tab" class="home-tab @(tab == Tab ? "active" : "")" aria-selected="@(tab == Tab)"
                                    @onclick="() => ShowTabAsync(tab)">
                                @TabLabel(tab)
                            </button>
                        }
                    </div>
                }

                @switch (Tab)
                {
                    case HomeTab.Favourites:
                        @ProductTiles
                        break;

                    case HomeTab.Departments:
                        <div class="big-grid">
                            @foreach (var department in Departments)
                            {
                                <button class="dept-tile" style="--hue:@Hue(DepartmentLabel(department.Name))"
                                        @onclick="() => OpenDepartmentAsync(department.Name)">
                                    <span class="dept-name">@DepartmentLabel(department.Name)</span>
                                    <span class="dept-count">@department.ProductCount @(department.ProductCount == 1 ? "product" : "products")</span>
                                </button>
                            }
                        </div>
                        break;

                    case HomeTab.Letters when AllProducts.Count <= ShowAllUpTo:
                        @ProductTiles
                        break;

                    case HomeTab.Letters:
                        <div class="letter-grid">
                            @foreach (var (letter, count) in Letters)
                            {
                                <button class="letter-tile" @onclick="() => ShowLetter(letter)">
                                    <span class="letter">@letter</span>
                                    <span class="dept-count">@count</span>
                                </button>
                            }
                        </div>
                        break;
                }

                @if (Tabs.Count == 0)
                {
                    <div class="empty-home">
                        <p>No products yet.</p>
                        <p class="muted">Add them in Manage → Products &amp; PLUs, or import them from a CSV or the old POS.</p>
                    </div>
                }
            }

            </div>
            }
        </div>

        <div class="order-panel">
            <div class="order-header">Current Order</div>

            <div class="order-lines">
                @if (CartLines.Count == 0)
                {
                    <div class="empty-cart">
                        <span class="empty-icon">🛒</span>
                        <p>No items yet</p>
                    </div>
                }
                else
                {
                    @foreach (var line in CartLines)
                    {
                        <div class="order-line @(line.IsReturn ? "is-return" : "")">
                            <div class="line-info">
                                <div class="line-name">
                                    @if (line.IsReturn)
                                    {
                                        <span class="line-tag">Return</span>
                                    }
                                    @line.Name
                                </div>
                                <div class="line-unit-price">@line.UnitPrice.ToString("C") each@(line.IsReturn ? $" · {line.ReturnReason}" : "")</div>
                            </div>
                            <div class="line-qty-controls">
                                <button @onclick="() => DecrementLineAsync(line)">−</button>
                                <span>@line.Quantity</span>
                                <button @onclick="() => IncrementLine(line)" disabled="@(line.Quantity >= line.MaxQuantity)">+</button>
                            </div>
                            <div class="line-total">@line.Total.ToString("C")</div>
                        </div>
                    }
                    @if (SurchargeRule is { } rule && GoodsTotal > 0)
                    {
                        @if (SurchargeApplies)
                        {
                            <div class="order-line surcharge">
                                <div class="line-info">
                                    <div class="line-name">@SurchargeCalculator.Label(rule.Name, rule.Percent)</div>
                                    <div class="line-unit-price">on @GoodsTotal.ToString("C")</div>
                                </div>
                                <button class="surcharge-btn" @onclick="RemoveSurchargeAsync">Remove</button>
                                <div class="line-total">@SurchargeAmount.ToString("C")</div>
                            </div>
                        }
                        else
                        {
                            <button class="surcharge-add" @onclick="() => (SurchargeOn, SurchargeOff) = (true, false)">+ Add @SurchargeCalculator.Label(rule.Name, rule.Percent)</button>
                        }
                    }
                }
            </div>

            <div class="order-footer">
                <div class="summary-row">
                    <span>@(GrandTotal < 0 ? "Refund" : "Total")</span>
                    <span>@Math.Abs(GrandTotal).ToString("C")</span>
                </div>

                <div class="function-buttons">
                    <button class="fn-btn fn-secondary" @onclick="VoidCartAsync" disabled="@(CartLines.Count == 0)">Void</button>
                    <button class="fn-btn fn-secondary" disabled="@(CartLines.Count == 0)">Hold</button>
                </div>
                <button class="fn-btn fn-primary @(GrandTotal < 0 ? "refund" : "")" disabled="@(CartLines.Count == 0)" @onclick="OpenCharge">
                    @(CartLines.Count == 0 ? "Charge" : GrandTotal > 0 ? $"Charge {GrandTotal:C}" : GrandTotal < 0 ? $"Refund {-GrandTotal:C}" : "Complete exchange")
                </button>
            </div>
        </div>

    </div>

    @if (ActiveSale is not null)
    {
        <TenderPanel Sale="ActiveSale"
                     CompleteSale="CompleteSaleAsync"
                     OnFinished="FinishSale"
                     OnCancel="CancelCharge" />
    }

    @if (ActiveRefund is not null)
    {
        <RefundPanel Sale="ActiveRefund"
                     Original="ReturnOfPayments"
                     CompleteRefund="CompleteRefundAsync"
                     OnFinished="FinishSale"
                     OnCancel="() => ActiveRefund = null" />
    }

    @if (ShowReturn)
    {
        <ReturnDialog InitialCode="@ReturnCode" OnAdd="AddReturn" OnClose="() => ShowReturn = false" />
    }

    @if (ShowGiftCard)
    {
        <GiftCardDialog OnAdd="AddGiftCard" OnClose="() => ShowGiftCard = false" />
    }
</div>

@code {
    // ---- the sell screen's home: Favourites, Departments, A–Z ----

    private enum HomeTab { Favourites, Departments, Letters }

    /// <summary>Up to this many products, A–Z shows them straight away (a café); above it, letters first.</summary>
    private const int ShowAllUpTo = 40;

    private IReadOnlyList<Product> Favourites = Array.Empty<Product>();
    private IReadOnlyList<DepartmentSummary> Departments = Array.Empty<DepartmentSummary>();
    private IReadOnlyList<Product> AllProducts = Array.Empty<Product>();
    private List<HomeTab> Tabs = new();
    private HomeTab Tab;
    private string? OpenDepartment;
    private string? OpenLetter;

    // One real department isn't worth a page: products without departments use A–Z instead.
    private bool HasDepartments => Departments.Count(d => d.Name.Length > 0) >= 2;

    private static string DepartmentLabel(string name) => name.Length == 0 ? "No department" : name;

    private static string TabLabel(HomeTab tab) => tab switch
    {
        HomeTab.Favourites => "★ Favourites",
        HomeTab.Departments => "Departments",
        _ => "A–Z"
    };

    private IEnumerable<(string Letter, int Count)> Letters => AllProducts
        .GroupBy(p => LetterOf(p.Name))
        .OrderBy(g => g.Key == "#" ? "~" : g.Key)
        .Select(g => (g.Key, g.Count()));

    private static string LetterOf(string name)
    {
        var first = name.TrimStart().FirstOrDefault();
        return char.IsLetter(first) ? char.ToUpperInvariant(first).ToString() : "#";
    }

    private async Task LoadHomeAsync()
    {
        Favourites = await Catalog.GetBestSellersAsync();
        Departments = await Catalog.GetDepartmentsAsync();
        AllProducts = HasDepartments ? Array.Empty<Product>() : await Catalog.GetAllActiveAsync();

        Tabs = new();
        if (Favourites.Count > 0) Tabs.Add(HomeTab.Favourites);
        if (HasDepartments) Tabs.Add(HomeTab.Departments);
        else if (AllProducts.Count > 0) Tabs.Add(HomeTab.Letters);

        if (Tabs.Count > 0 && !Tabs.Contains(Tab))
            Tab = Tabs[0];
        await ShowTabAsync(Tab);
    }

    private Task ShowTabAsync(HomeTab tab)
    {
        Tab = tab;
        (OpenDepartment, OpenLetter, SearchTerm) = (null, null, null);
        Products = tab switch
        {
            HomeTab.Favourites => Favourites,
            HomeTab.Letters when AllProducts.Count <= ShowAllUpTo => AllProducts,
            _ => Array.Empty<Product>()
        };
        return Task.CompletedTask;
    }

    private async Task OpenDepartmentAsync(string name)
    {
        (OpenDepartment, OpenLetter, SearchTerm) = (name, null, null);
        Products = await Catalog.GetProductsByCategoryAsync(name);
    }

    private void ShowLetter(string letter)
    {
        (OpenDepartment, OpenLetter, SearchTerm) = (null, letter, null);
        Products = AllProducts.Where(p => LetterOf(p.Name) == letter).ToList();
    }

    private Task BackHome() => ShowTabAsync(Tab);

    /// <summary>The product tiles for whatever is open: favourites, a department, a letter or search results.</summary>
    private RenderFragment ProductTiles => __builder =>
    {
        <div class="product-grid">
            @foreach (var product in Products)
            {
                <button class="product-tile" @onclick="() => AddToCart(product)">
                    <div class="product-image">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Name" />
                        }
                        else
                        {
                            <div class="image-placeholder" style="--hue:@Hue(product.Name)">@Initials(product.Name)</div>
                        }
                    </div>
                    <div class="product-name">@product.Name</div>
                    <div class="product-price">@product.Price.ToString("C")</div>
                </button>
            }
        </div>
    };

    // A product without a photo gets its initials on a colour picked from its name: the same product
    // always looks the same, and neighbours look different, so it can be found at a glance.
    private static int Hue(string name) => (int)((uint)name.Aggregate(17, (h, c) => unchecked(h * 31 + char.ToUpperInvariant(c))) % 360);

    private static string Initials(string name)
    {
        // Words that start with a letter: "Absolut 6pk" is AB, not A6.
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(w => char.IsLetter(w[0])).ToList();
        return words.Count switch
        {
            0 => "?",
            1 => words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant(),
            _ => string.Concat(char.ToUpperInvariant(words[0][0]), char.ToUpperInvariant(words[1][0]))
        };
    }
    private IReadOnlyList<Product> Products = new List<Product>();

    // Non-null while the grid is showing name-search results instead of a category.
    private string? SearchTerm;

    private List<CartLine> CartLines = new();

    /// <summary>Goods bought (not returns, not gift cards): what a surcharge is worked out on.</summary>
    private decimal GoodsTotal => CartLines.Where(l => !l.IsReturn && l.GiftCardCode is null).Sum(l => l.Total);

    /// <summary>Negative when more comes back than is bought: a refund.</summary>
    private decimal GrandTotal => CartLines.Sum(l => l.Total) + SurchargeAmount;

    // ---- settings, returns, gift cards, surcharge ----
    private RegisterSettings Settings = new();
    private SaleTransaction? ActiveRefund;
    private bool Paying => ActiveSale is not null || ActiveRefund is not null;
    private bool ShowReturn;
    private string? ReturnCode;
    private bool ShowGiftCard;
    private string? ScanNote;

    /// <summary>The sale items are being returned from (one per transaction), and how it was paid.</summary>
    private (Guid SaleId, long Invoice)? ReturnOf;
    private IReadOnlyList<SalePayment>? ReturnOfPayments;

    private bool SurchargeOff;   // taken off this sale (automatic surcharge)
    private bool SurchargeOn;    // added to this sale (when the cashier adds it)
    private (string Name, decimal Percent)? SurchargeRule => SurchargeCalculator.For(DateOnly.FromDateTime(DateTime.Now), Settings.Surcharges);
    private bool SurchargeApplies => SurchargeRule is not null && GoodsTotal > 0 && (Settings.Surcharges.Automatic ? !SurchargeOff : SurchargeOn);
    private decimal SurchargeAmount => SurchargeApplies ? SurchargeCalculator.Amount(GoodsTotal, SurchargeRule!.Value.Percent) : 0;

    [Inject] private IGiftCardService GiftCards { get; set; } = default!;

    [Inject] private ScanResolutionService ScanResolver { get; set; } = default!;
    [Inject] private OnScreenKeyboardService Keyboard { get; set; } = default!;
    [Inject] private ICheckoutService Checkout { get; set; } = default!;
    [Inject] private RegisterTerminal Terminal { get; set; } = default!;
    [Inject] private IJournal Journal { get; set; } = default!;
    [Inject] private ILocalHardwareService Hardware { get; set; } = default!;
    [Inject] private IRegisterSettingsStore SettingsStore { get; set; } = default!;

    // "No sale" is only offered when a cash drawer is set up (Manage → Receipt & Printer).
    private bool DrawerEnabled;

    // GST included in prices, unless the product is GST-free.
    private const decimal GstRate = 0.10m;

    // The sale being paid for while the tender panel is open; null otherwise.
    private SaleTransaction? ActiveSale;

    private string ScanInput = string.Empty;
    private string? ScanError;

    protected override async Task OnInitializedAsync()
    {
        Settings = SettingsStore.Load();
        DrawerEnabled = Settings.Printer.DrawerMode != CashDrawerMode.None;

        await LoadHomeAsync();
    }

    private async Task ClearSearchAsync()
    {
        ScanError = null;
        if (OpenDepartment is not null)
            await OpenDepartmentAsync(OpenDepartment);
        else if (OpenLetter is not null)
            ShowLetter(OpenLetter);
        else
            await ShowTabAsync(Tab);
    }

    private void AddToCart(Product product) =>
        AddLine($"P:{product.Id}", SkuFor(product.Plu, product.Barcode, $"P{product.Id}"),
                product, product.Name, product.Price, packUnits: 1);

    // A pack size (6-pack, carton…) sells at its own price but is still the same base product.
    private void AddToCart(ProductVariant variant) =>
        AddLine($"V:{variant.Id}", SkuFor(variant.Plu, variant.Barcode, $"V{variant.Id}"),
                variant.Product, $"{variant.Product.Name} ({variant.DisplayName})", variant.Price, Math.Max(1, variant.UnitQuantity));

    // PLU first, then barcode, then the internal id — PLU-screen edits can leave "" rather than null.
    private static string SkuFor(string? plu, string? barcode, string fallback) =>
        !string.IsNullOrWhiteSpace(plu) ? plu
        : !string.IsNullOrWhiteSpace(barcode) ? barcode
        : fallback;

    private void AddLine(string key, string sku, Product product, string name, decimal unitPrice, int packUnits)
    {
        ScanNote = null;
        // A locked licence stops new sales from starting; one already on the screen can still be paid.
        if (CartLines.Count == 0 && !Licence.CanStartSale)
        {
            ScanError = Licence.Current.Headline;
            return;
        }

        var existing = CartLines.FirstOrDefault(l => l.Key == key);
        if (existing is not null)
        {
            existing.Quantity++;
        }
        else
        {
            CartLines.Add(new CartLine
            {
                Key = key, Sku = sku, Name = name, UnitPrice = unitPrice, PackUnits = packUnits, Quantity = 1,
                GstRate = product.IsGstFree ? 0m : GstRate, Category = product.Category, ProductId = product.Id
            });
        }
    }

    // ---- Charge ----

    private void OpenCharge()
    {
        if (CartLines.Count == 0) return;
        if (GrandTotal <= 0 && !CartLines.Any(l => l.IsReturn)) return;

        // Build the sale from the cart. Its GUID goes to the EFTPOS terminal as the reference.
        var sale = new SaleTransaction(Terminal.StoreId, Terminal.RegisterId,
                                       Session.Employee?.Id, Session.Employee?.FullName);
        foreach (var line in CartLines)
        {
            sale.AddLineItem(new SaleLineItem(line.Sku, line.Name, line.IsReturn ? -line.Quantity : line.Quantity, line.UnitPrice,
                line.GstRate, line.Category, line.ProductId, line.PackUnits,
                line.ReturnOfLineId, line.ReturnReason, line.Restock, line.GiftCardCode));
        }

        if (SurchargeAmount > 0 && SurchargeRule is { } rule)
        {
            // GST on the surcharge follows the goods: GST-free only when everything surcharged is GST-free.
            var gst = CartLines.Where(l => !l.IsReturn && l.GiftCardCode is null).All(l => l.GstRate == 0) ? 0m : GstRate;
            sale.AddLineItem(new SaleLineItem(SurchargeCalculator.Sku, SurchargeCalculator.Label(rule.Name, rule.Percent), 1,
                SurchargeAmount, gst, SurchargeCalculator.Category));
        }

        if (ReturnOf is { } original)
            sale.MarkAsReturnOf(original.SaleId, original.Invoice);

        if (sale.GrandTotal > 0)
            ActiveSale = sale;
        else
            ActiveRefund = sale;
    }

    // Called by the tender panel once fully paid. If it throws, the panel shows "Retry Save".
    private Task<long> CompleteSaleAsync(TenderSession tender) =>
        Checkout.CompleteSaleAsync(ActiveSale!, tender);

    private Task<long> CompleteRefundAsync(RefundSession refund) =>
        Checkout.CompleteSaleAsync(ActiveRefund!, refund);

    private void FinishSale()
    {
        ActiveSale = null;
        ActiveRefund = null;
        CartLines.Clear();
        ScanError = null;
        ScanNote = null;
        ClearReturn();
        (SurchargeOff, SurchargeOn) = (false, false);
        Settings = SettingsStore.Load();
    }

    private void ClearReturn() => (ReturnOf, ReturnOfPayments) = (null, null);

    // ---- returns ----

    private void OpenReturn(string? code)
    {
        if (Paying) return;
        (ReturnCode, ShowReturn) = (code, true);
    }

    /// <summary>The items chosen in the Return window go on the order as return lines (negative).</summary>
    private void AddReturn(ReturnSelection selection)
    {
        if (ReturnOf is { } current && current.SaleId != selection.Sale.Id)
        {
            ScanError = $"This order already returns items from invoice #{current.Invoice}. Finish it first.";
            ShowReturn = false;
            return;
        }

        ReturnOf = (selection.Sale.Id, selection.Sale.InvoiceNumber!.Value);
        ReturnOfPayments = selection.Sale.Payments.ToList();

        foreach (var item in selection.Items)
        {
            var line = item.Line;
            var key = $"R:{line.Id}";
            CartLines.RemoveAll(l => l.Key == key);
            CartLines.Add(new CartLine
            {
                Key = key, Sku = line.Sku, Name = line.ProductName, UnitPrice = line.UnitPriceIncGst, PackUnits = line.PackUnits,
                Quantity = item.Quantity, GstRate = line.GstRate, Category = line.Category, ProductId = line.ProductId,
                IsReturn = true, ReturnOfLineId = line.Id, ReturnReason = item.Reason, Restock = item.Restock,
                MaxQuantity = item.Quantity
            });
        }

        ShowReturn = false;
        ScanError = null;
        ScanNote = $"Returning from invoice #{selection.Sale.InvoiceNumber}. Scan new items for an exchange, or tap Refund.";
    }

    // ---- gift cards ----

    private void AddGiftCard((string Code, decimal Amount) card)
    {
        if (CartLines.Count == 0 && !Licence.CanStartSale)
        {
            ScanError = Licence.Current.Headline;
            ShowGiftCard = false;
            return;
        }
        var key = $"G:{card.Code}";
        CartLines.RemoveAll(l => l.Key == key);
        CartLines.Add(new CartLine
        {
            Key = key, Sku = "GIFTCARD", Name = $"Gift card {card.Code}", UnitPrice = card.Amount, PackUnits = 1, Quantity = 1,
            GstRate = 0m, Category = "Gift cards", GiftCardCode = card.Code, MaxQuantity = 1
        });
        ShowGiftCard = false;
        ScanNote = $"Gift card {card.Code} for {card.Amount:C} is loaded when this sale is paid.";
    }

    private async Task RemoveSurchargeAsync()
    {
        (SurchargeOff, SurchargeOn) = (true, false);
        if (SurchargeRule is { } rule)
            await Journal.WriteAsync(JournalEventType.SurchargeRemoved,
                $"{SurchargeCalculator.Label(rule.Name, rule.Percent)} taken off by {Session.Employee?.FullName}", amount: SurchargeCalculator.Amount(GoodsTotal, rule.Percent));
    }

    // Back to Order before any payment: the sale was never saved, the cart is untouched.
    private void CancelCharge() => ActiveSale = null;

    // Opens the drawer without a sale (change for the till etc.) — always journalled, like legacy NOSALE.
    private async Task NoSaleAsync()
    {
        if (ActiveSale is not null) return;

        var result = await Hardware.OpenCashDrawerAsync();
        if (!result.Succeeded)
        {
            ScanError = result.Message;
            return;
        }

        ScanError = null;
        await Journal.WriteAsync(JournalEventType.NoSale, $"No sale - drawer opened by {Session.Employee?.FullName}");
    }

    private async Task SignOutAsync()
    {
        if (ActiveSale is not null) return;

        if (CartLines.Count > 0)
        {
            ScanError = "Finish or void the current sale before signing out.";
            return;
        }

        // Journal first, while the employee is still signed in, so the entry is stamped with them.
        await Journal.WriteAsync(JournalEventType.SignOut, $"{Session.Employee?.FullName} signed out");
        Session.SignOut();
        Nav.NavigateTo("/login", replace: true);
    }

    private void IncrementLine(CartLine line)
    {
        if (line.Quantity < line.MaxQuantity)
            line.Quantity++;
    }

    private async Task DecrementLineAsync(CartLine line)
    {
        line.Quantity--;
        if (line.Quantity <= 0)
        {
            CartLines.Remove(line);
        }

        if (!CartLines.Any(l => l.IsReturn))
            ClearReturn();

        await Journal.WriteAsync(JournalEventType.LineRemoved,
            $"{(line.IsReturn ? "Return of " : "")}{line.Name} x1 removed ({Math.Max(0, line.Quantity)} left)", amount: line.UnitPrice);
    }

    private async Task VoidCartAsync()
    {
        if (CartLines.Count == 0) return;

        var total = GrandTotal;
        var items = string.Join(", ", CartLines.Select(l => $"{(l.IsReturn ? "return " : "")}{l.Name} x{l.Quantity}"));
        CartLines.Clear();
        ClearReturn();
        (SurchargeOff, SurchargeOn) = (false, false);

        await Journal.WriteAsync(JournalEventType.SaleVoided, $"Cart voided: {items}", amount: total);
    }

    private void OpenScanKeyboard()
    {
        Keyboard.RequestInput(
            initialValue: ScanInput,
            numericOnly: false,
            onValueChanged: value => { ScanInput = value; InvokeAsync(StateHasChanged); },
            onSubmit: () => _ = ProcessScanAsync()
        );
    }

    private async Task ProcessScanAsync()
    {
        var input = ScanInput.Trim();
        if (input.Length == 0) return;

        ScanError = null;

        try
        {
            // 1. Exact code first (PLU, barcode, voucher, customer card) — this is the scanner path.
            var result = await ScanResolver.ResolveAsync(input);

            if (result.Type == ScanResultType.Product)
            {
                // ProductScanResolver returns either a Product or a ProductVariant (pack-size barcode).
                switch (result.Payload)
                {
                    case ProductVariant variant:
                        AddToCart(variant);
                        break;
                    case Product product:
                        AddToCart(product);
                        break;
                }
            }
            else if (result.Type == ScanResultType.Receipt)
            {
                OpenReturn((string)result.Payload!);
            }
            else if (result.Type == ScanResultType.Voucher)
            {
                var card = await GiftCards.GetAsync((string)result.Payload!);
                ScanNote = card is null
                    ? $"{result.Payload} isn't a gift card or store credit on this register."
                    : $"{card.KindName} {card.Code}: {card.Balance:C} left{(card.IsActive ? "" : " (cancelled)")}. Use it on the payment screen.";
            }
            else if (result.Type == ScanResultType.NotFound)
            {
                // 2. Not an exact code: search by name / partial code
                //    (legacy: IsNumeric → IndexSearch, otherwise SearchNameIndex).
                await SearchByNameAsync(input);
            }
        }
        catch (Exception)
        {
            ScanError = "Search failed. Please try again.";
        }

        ScanInput = string.Empty;
        StateHasChanged();
    }

    private async Task SearchByNameAsync(string term)
    {
        var matches = await Catalog.SearchAsync(term);

        switch (matches.Count)
        {
            case 0:
                ScanError = $"No match for '{term}'.";
                break;

            default:
                // Name search never auto-adds: always show matches so the cashier picks.
                SearchTerm = term;
                Products = matches;
                break;
        }
    }

    private sealed class CartLine
    {
        /// <summary>"P:{productId}" / "V:{variantId}" (the same product in two pack sizes is two lines),
        /// "R:{original line}" for a return, "G:{code}" for a gift card.</summary>
        public required string Key { get; init; }
        public required string Sku { get; init; }
        public required string Name { get; init; }
        public required decimal UnitPrice { get; init; }

        /// <summary>Singles per item: 1, or 6 for a 6-pack. Stock goes down by Quantity × PackUnits.</summary>
        public required int PackUnits { get; init; }
        public int Quantity { get; set; }

        public decimal GstRate { get; init; }
        public string? Category { get; init; }
        public int? ProductId { get; init; }

        /// <summary>A returned item: Quantity is how many come back; the line counts as negative.</summary>
        public bool IsReturn { get; init; }
        public Guid? ReturnOfLineId { get; init; }
        public string? ReturnReason { get; init; }
        public bool Restock { get; init; } = true;

        public string? GiftCardCode { get; init; }

        /// <summary>No more than this (what can still be returned; one per gift card).</summary>
        public int MaxQuantity { get; init; } = int.MaxValue;

        public decimal Total => (IsReturn ? -1 : 1) * UnitPrice * Quantity;
    }
}
